{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "hive-app-compatibility-preview",
  "main": "worker.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "services": [{ "binding": "AUTH_SERVICE", "service": "hive-auth-compatibility-preview" }],
  "assets": {
    "directory": "../../../.open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "limits": { "cpu_ms": 100 },
  "observability": { "enabled": false, "logs": { "enabled": false, "invocation_logs": false } },
  "vars": {
    "HIVE_RUNTIME_TARGET": "cloudflare",
    "HIVE_DISABLE_BACKGROUND_WORKERS": "true",
    "CODER_URL": "https://coder.kethalia.com"
  }
}
