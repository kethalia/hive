{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "hive-jobs-production",
  "account_id": "225177f82b9234ede14e897fe15e0cb5",
  "main": "./bootstrap.mjs",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": []
  },
  "limits": {
    "cpu_ms": 100
  },
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    }
  },
  "vars": {
    "HIVE_DEPLOYMENT_STATE": "awaiting-main-release",
    "HIVE_PROJECT_TASKS_ENABLED": "false",
    "HIVE_DELIVERY_RELEASE_ENABLED": "false",
    "HIVE_DELIVERY_RELEASE_PRODUCTION_ENABLED": "false",
    "HIVE_DELIVERY_DATABASE_ENABLED": "false"
  }
}
