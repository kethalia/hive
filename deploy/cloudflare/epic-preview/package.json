{
  "name": "hive-epic-preview-probe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "test": "node --test worker.test.mjs",
    "generate": "prisma generate --schema prisma/schema.prisma",
    "preview": "pnpm generate && wrangler dev --local --ip 127.0.0.1",
    "build": "pnpm generate && wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@prisma/adapter-neon": "6.19.3",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "wrangler": "4.155.0"
  }
}
