{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "hive-auth-compatibility-preview",
  "main": "worker.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": [] },
  "limits": { "cpu_ms": 100 },
  "observability": { "enabled": false, "logs": { "enabled": false, "invocation_logs": false } },
  "vars": {
    "HIVE_RUNTIME_TARGET": "cloudflare",
    "HIVE_TOKEN_ROTATION_ENABLED": "false",
    "CODER_URL": "https://coder.kethalia.com"
  }
}
