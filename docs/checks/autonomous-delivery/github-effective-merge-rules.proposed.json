{
  "name": "Hive managed delivery - exact main and epic gates",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main", "refs/heads/codex/delivery-system-design"],
      "exclude": []
    }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "allowed_merge_methods": ["merge", "squash", "rebase"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "Build / Lint / Test / Build", "integration_id": 15368 },
          { "context": "Build / Lint / Test / Lint", "integration_id": 15368 },
          { "context": "Build / Lint / Test / Format", "integration_id": 15368 },
          { "context": "Migration preflight / PostgreSQL", "integration_id": 15368 }
        ]
      }
    }
  ]
}
