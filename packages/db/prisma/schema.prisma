  managerBindings DeliveryManagerBinding[]
  guardianAdmissions CodexGuardianAdmission[]
  @@unique([ownerId, id])
  @@unique([ownerId, projectId, id])
  @@unique([ownerId, projectId, requestId])
  @@index([phase, nextAttemptAt])
  @@map("project_task_intents")
}

