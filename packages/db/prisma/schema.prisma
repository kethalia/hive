generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NavigationFavoriteKind {
  terminal
  git
}

model User {
  id                           String   @id @default(uuid()) @db.Uuid
  coderUrl                     String   @map("coder_url")
  coderUserId                  String   @map("coder_user_id") @db.Uuid
  username                     String
  email                        String
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  terminalControlsBeyondMobile Boolean  @default(false) @map("terminal_controls_beyond_mobile")

  coderTokens         CoderToken[]
  sessions            Session[]
  pushSubscriptions   PushSubscription[]
  notificationSources NotificationSource[]
  navigationFavorites NavigationFavorite[]
  deliveryProjects    DeliveryProject[]
  codexHostSlots      CodexHostSlot[]

  @@unique([coderUrl, coderUserId])
  @@map("users")
}

model CoderToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  ciphertext Bytes
  iv         Bytes
  authTag    Bytes    @map("auth_tag")
  version    Int       @default(1)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz
  // Only a positively identified key created by Hive; legacy credentials stay null.
  remoteKeyId String? @map("remote_key_id")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@unique([userId])
  @@map("coder_tokens")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @unique @default(uuid()) @map("session_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("sessions")
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String @unique
  preferences Json @default("{}")
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

model NavigationFavorite {
  id           String                 @id @default(uuid()) @db.Uuid
  userId       String                 @map("user_id") @db.Uuid
  kind         NavigationFavoriteKind
  workspaceId  String                 @map("workspace_id")
  targetKey    String                 @map("target_key")
  label        String?
  relativePath String?                @map("relative_path")
  position     Int                    @default(2147483647)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, workspaceId, targetKey])
  @@index([userId, kind, workspaceId])
  @@index([userId, position])
  @@map("navigation_favorites")
}

model VapidKeys {
  id         Int      @id @default(1)
  publicKey  String   @map("public_key")
  privateKey String   @map("private_key")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("vapid_keys")
}

model NotificationSource {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  workspaceName String @map("workspace_name")
  tokenHash String @unique @map("token_hash")
  pendingTokenHash String? @unique @map("pending_token_hash")
  credentialGeneration Int @default(0) @map("credential_generation")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, workspaceId])
  @@map("notification_sources")
}

// Delivery is additive and separate from the retired task runner. Every child
// relation carries ownerId; repository methods additionally enforce owner access.
model DeliveryProject {
  id                   String @id @default(uuid()) @db.Uuid
  ownerId              String @map("owner_id") @db.Uuid
  provider             String
  providerRepositoryId String @map("provider_repository_id")
  providerAccountId    String @map("provider_account_id")
  fullName             String @map("full_name")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  owner                User @relation(fields: [ownerId], references: [id])
  conversations        DeliveryConversation[]
  registeredThreads    CodexRegisteredThread[]
  taskIntents          ProjectTaskIntent[]
  epics                DeliveryEpic[]
  tasks                DeliveryTask[]
  managerBindings      DeliveryManagerBinding[]
  @@unique([ownerId, id])
  @@unique([ownerId, provider, providerRepositoryId])
  @@map("delivery_projects")
}

model DeliveryConversation {
  id            String @id @default(uuid()) @db.Uuid
  ownerId       String @map("owner_id") @db.Uuid
  projectId     String @map("project_id") @db.Uuid
  workspaceId   String @map("workspace_id") @db.Uuid
  nativeThreadId String @map("native_thread_id")
  buildId       String @map("build_id") @db.Uuid
  serverInstanceId String @map("server_instance_id")
  nativePath    String? @map("native_path")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  project       DeliveryProject @relation(fields: [ownerId, projectId], references: [ownerId, id])
  tasks         DeliveryTask[]
  managerBindings DeliveryManagerBinding[]
  registeredThreads CodexRegisteredThread[]
  @@unique([ownerId, id])
  @@unique([ownerId, projectId, id])
  @@unique([ownerId, workspaceId, nativeThreadId])
  @@map("delivery_conversations")
}

model DeliveryEpic {
  id          String @id @default(uuid()) @db.Uuid
  ownerId     String @map("owner_id") @db.Uuid
  projectId   String @map("project_id") @db.Uuid
  outcome     String
  criteria    Json
  state       String @default("pending")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  project     DeliveryProject @relation(fields: [ownerId, projectId], references: [ownerId, id])
  tasks       DeliveryTask[]
  @@unique([ownerId, id])
  @@unique([ownerId, projectId, id])
  @@map("delivery_epics")
}

model DeliveryTask {
  id               String @id @default(uuid()) @db.Uuid
  ownerId          String @map("owner_id") @db.Uuid
  projectId        String @map("project_id") @db.Uuid
  epicId           String? @map("epic_id") @db.Uuid
  conversationId   String? @map("conversation_id") @db.Uuid
  managerBindingId String? @map("manager_binding_id") @db.Uuid
  outcome          String
  sourceSha        String @map("source_sha")
  branch           String
  version          Int @default(0)
  pauseRequested   Boolean @default(false) @map("pause_requested")
  schedulingPaused Boolean @default(false) @map("scheduling_paused")
  releaseMode      String @default("disabled") @map("release_mode")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  project          DeliveryProject @relation(fields: [ownerId, projectId], references: [ownerId, id])
  epic             DeliveryEpic? @relation(fields: [ownerId, projectId, epicId], references: [ownerId, projectId, id], onDelete: Restrict)
  conversation     DeliveryConversation? @relation(fields: [ownerId, projectId, conversationId], references: [ownerId, projectId, id], onDelete: Restrict)
  managerBinding   DeliveryManagerBinding? @relation(fields: [ownerId, projectId, managerBindingId], references: [ownerId, projectId, id], onDelete: Restrict)
  steps            DeliveryStep[]
  events           DeliveryEvent[]
  @@unique([ownerId, id])
  @@map("delivery_tasks")
}

model DeliveryStep {
  id                    String @id @default(uuid()) @db.Uuid
  ownerId               String @map("owner_id") @db.Uuid
  taskId                String @map("task_id") @db.Uuid
  kind                  String
  acceptancePhase       String @default("implementation_preview") @map("acceptance_phase")
  state                 String @default("pending")
  waitingReason         String? @map("waiting_reason")
  version               Int @default(0)
  reopenGeneration      Int @default(0) @map("reopen_generation")
  leaseGeneration       Int @default(0) @map("lease_generation")
  attemptCount          Int @default(0) @map("attempt_count")
  attemptBudget         Int @default(3) @map("attempt_budget")
  criterionIds          String[] @map("criterion_ids")
  requiredEvidenceKinds String[] @map("required_evidence_kinds")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  task                  DeliveryTask @relation(fields: [ownerId, taskId], references: [ownerId, id])
  attempts              DeliveryAttempt[]
  evidence              DeliveryEvidence[]
  reports               DeliveryStepReport[]
  events                DeliveryEvent[]
  dependencies          DeliveryStepDependency[] @relation("StepDependencies")
  dependents            DeliveryStepDependency[] @relation("StepDependents")
  @@unique([ownerId, id])
  @@unique([ownerId, taskId, id])
  @@index([ownerId, taskId, state])
  @@map("delivery_steps")
}

model DeliveryStepDependency {
  ownerId         String @map("owner_id") @db.Uuid
  taskId          String @map("task_id") @db.Uuid
  stepId          String @map("step_id") @db.Uuid
  dependsOnStepId String @map("depends_on_step_id") @db.Uuid
  step            DeliveryStep @relation("StepDependencies", fields: [ownerId, taskId, stepId], references: [ownerId, taskId, id], onDelete: Restrict)
  dependsOn       DeliveryStep @relation("StepDependents", fields: [ownerId, taskId, dependsOnStepId], references: [ownerId, taskId, id], onDelete: Restrict)
  @@id([ownerId, taskId, stepId, dependsOnStepId])
  @@map("delivery_step_dependencies")
}

model DeliveryAttempt {
  id               String @id @default(uuid()) @db.Uuid
  ownerId          String @map("owner_id") @db.Uuid
  stepId           String @map("step_id") @db.Uuid
  managerBindingId String? @map("manager_binding_id") @db.Uuid
  leaseGeneration  Int @map("lease_generation")
  leaseHolder      String @map("lease_holder")
  leaseExpiresAt   DateTime @map("lease_expires_at") @db.Timestamptz
  sourceSha        String @map("source_sha")
  requestedModel   String? @map("requested_model")
  effectiveModel   String? @map("effective_model")
  requestedEffort  String? @map("requested_effort")
  effectiveEffort  String? @map("effective_effort")
  outcome          String @default("running")
  runtimeBinding   Json? @map("runtime_binding")
  runtimeBindingDigest String? @map("runtime_binding_digest")
  runtimeVersion   Int @default(0) @map("runtime_version")
  quiescedAt       DateTime? @map("quiesced_at") @db.Timestamptz
  startedAt        DateTime @default(now()) @map("started_at") @db.Timestamptz
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz
  step             DeliveryStep @relation(fields: [ownerId, stepId], references: [ownerId, id])
  reports          DeliveryStepReport[]
  events           DeliveryEvent[]
  managerBinding   DeliveryManagerBinding? @relation("ManagerAttempt", fields: [ownerId, managerBindingId], references: [ownerId, id], onDelete: Restrict)
  activeForBindings DeliveryManagerBinding[] @relation("ActiveManagerAttempt")
  @@unique([ownerId, id])
  @@unique([ownerId, stepId, id])
  @@unique([ownerId, managerBindingId, id])
  @@unique([ownerId, stepId, leaseGeneration])
  @@map("delivery_attempts")
}

model DeliveryEvidence {
  id             String @id @default(uuid()) @db.Uuid
  ownerId        String @map("owner_id") @db.Uuid
  stepId         String @map("step_id") @db.Uuid
  producer       String
  policyVersion  String @map("policy_version")
  remoteId       String @map("remote_id")
  kind           String
  status         String
  verificationMode String @map("verification_mode")
  environment    String
  sourceSha      String @map("source_sha")
  artifactDigest String? @map("artifact_digest")
  criterionIds   String[] @map("criterion_ids")
  objectKey      String @map("object_key")
  contentDigest  String @map("content_digest")
  requestDigest  String @map("request_digest")
  observedAt     DateTime @map("observed_at") @db.Timestamptz
  invalidatedAt  DateTime? @map("invalidated_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  step           DeliveryStep @relation(fields: [ownerId, stepId], references: [ownerId, id])
  reports        DeliveryReportEvidence[]
  @@unique([ownerId, id])
  @@unique([ownerId, stepId, id])
  @@unique([ownerId, stepId, producer, remoteId])
  @@map("delivery_evidence")
}

model DeliveryEvent {
  id               String @id @db.Uuid
  ownerId          String @map("owner_id") @db.Uuid
  taskId           String @map("task_id") @db.Uuid
  stepId           String? @map("step_id") @db.Uuid
  attemptId        String? @map("attempt_id") @db.Uuid
  aggregateKey     String @map("aggregate_key")
  aggregateVersion Int @map("aggregate_version")
  schemaVersion    Int @default(1) @map("schema_version")
  policyVersion    String @default("disabled-v1") @map("policy_version")
  type             String
  requestDigest    String @map("request_digest")
  payload          Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  task             DeliveryTask @relation(fields: [ownerId, taskId], references: [ownerId, id])
  step             DeliveryStep? @relation(fields: [ownerId, taskId, stepId], references: [ownerId, taskId, id], onDelete: Restrict)
  attempt          DeliveryAttempt? @relation(fields: [ownerId, stepId, attemptId], references: [ownerId, stepId, id], onDelete: Restrict)
  report           DeliveryStepReport?
  outbox           DeliveryOutbox[]
  @@unique([ownerId, id])
  @@unique([ownerId, stepId, id])
  @@unique([ownerId, aggregateKey, aggregateVersion])
  @@index([ownerId, taskId, attemptId, aggregateVersion], map: "delivery_runtime_events_lookup")
  @@map("delivery_events")
}

model DeliveryStepReport {
  id                   String @id @default(uuid()) @db.Uuid
  ownerId              String @map("owner_id") @db.Uuid
  stepId               String @map("step_id") @db.Uuid
  attemptId            String @map("attempt_id") @db.Uuid
  eventId              String @unique @map("event_id") @db.Uuid
  summary              String
  difficulty           String
  difficultyReason     String @map("difficulty_reason")
  issues               Json
  remainingUncertainty String @map("remaining_uncertainty")
  nextAction           String @map("next_action")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  step                 DeliveryStep @relation(fields: [ownerId, stepId], references: [ownerId, id])
  attempt              DeliveryAttempt @relation(fields: [ownerId, stepId, attemptId], references: [ownerId, stepId, id], onDelete: Restrict)
  event                DeliveryEvent @relation(fields: [ownerId, stepId, eventId], references: [ownerId, stepId, id], onDelete: Restrict)
  evidence             DeliveryReportEvidence[]
  @@unique([ownerId, id])
  @@unique([ownerId, stepId, id])
  @@unique([ownerId, eventId])
  @@unique([ownerId, stepId, eventId])
  @@map("delivery_step_reports")
}

model DeliveryReportEvidence {
  ownerId    String @map("owner_id") @db.Uuid
  stepId     String @map("step_id") @db.Uuid
  reportId   String @map("report_id") @db.Uuid
  evidenceId String @map("evidence_id") @db.Uuid
  report     DeliveryStepReport @relation(fields: [ownerId, stepId, reportId], references: [ownerId, stepId, id], onDelete: Restrict)
  evidence   DeliveryEvidence @relation(fields: [ownerId, stepId, evidenceId], references: [ownerId, stepId, id], onDelete: Restrict)
  @@id([ownerId, reportId, evidenceId])
  @@map("delivery_report_evidence")
}

model DeliveryOutbox {
  id            String @id @default(uuid()) @db.Uuid
  ownerId       String @map("owner_id") @db.Uuid
  eventId       String @map("event_id") @db.Uuid
  channel       String @default("push")
  status        String @default("pending")
  attempts      Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  event         DeliveryEvent @relation(fields: [ownerId, eventId], references: [ownerId, id])
  @@unique([ownerId, id])
  @@unique([ownerId, eventId, channel])
  @@index([status, nextAttemptAt])
  @@map("delivery_outbox")
}

// Registration authority only. All host rows are tenant-bound; grants store digests,
// never signed bearer grants. A slot serializes every lifetime transition.
model CodexHostSlot {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  coderOrigin String @map("coder_origin")
  coderOwnerId String @map("coder_owner_id") @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  agentId String @map("agent_id") @db.Uuid
  generation Int @default(0)
  activeRegistrationId String? @map("active_registration_id") @db.Uuid
  owner User @relation(fields: [ownerId], references: [id])
  grants CodexRegistrationGrant[]
  registrations CodexHostRegistration[]
  @@unique([ownerId, id])
  @@unique([ownerId, coderOrigin, workspaceId, agentId])
  @@map("codex_host_slots")
}

model CodexRegistrationGrant {
  id String @id @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  slotId String @map("slot_id") @db.Uuid
  generation Int
  binding Json
  bindingDigest String @map("binding_digest")
  tokenDigest String? @unique @map("token_digest")
  issuedAt DateTime @default(now()) @map("issued_at") @db.Timestamptz
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  slot CodexHostSlot @relation(fields: [ownerId, slotId], references: [ownerId, id])
  @@unique([slotId, generation])
  @@map("codex_registration_grants")
}

model CodexHostRegistration {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  slotId String @map("slot_id") @db.Uuid
  generation Int
  binding Json
  buildId String @map("build_id") @db.Uuid
  templateId String @map("template_id") @db.Uuid
  appId String @map("app_id") @db.Uuid
  appOrigin String @map("app_origin")
  serverInstanceId String @map("server_instance_id")
  protocolVersion String @map("protocol_version")
  hostPublicKeyPem String @map("host_public_key_pem")
  hostKeyFingerprint String @map("host_key_fingerprint")
  registeredAt DateTime @map("registered_at") @db.Timestamptz
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  heartbeatSequence Int @default(0) @map("heartbeat_sequence")
  heartbeatNonce String @map("heartbeat_nonce") @db.Uuid
  heartbeatRequestDigest String? @map("heartbeat_request_digest")
  slot CodexHostSlot @relation(fields: [ownerId, slotId], references: [ownerId, id])
  threads CodexRegisteredThread[]
  @@unique([ownerId, id])
  @@unique([ownerId, slotId, id])
  @@unique([slotId, generation])
  @@map("codex_host_registrations")
}

model CodexRegisteredThread {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  registrationId String @map("registration_id") @db.Uuid
  nativeThreadId String @map("native_thread_id")
  project DeliveryProject @relation(fields: [ownerId, projectId], references: [ownerId, id])
  conversation DeliveryConversation @relation(fields: [ownerId, projectId, conversationId], references: [ownerId, projectId, id])
  registration CodexHostRegistration @relation(fields: [ownerId, registrationId], references: [ownerId, id])
  @@unique([registrationId, projectId])
  @@unique([registrationId, nativeThreadId])
  @@index([ownerId, projectId])
  @@map("codex_registered_threads")
}


// Durable preparation survives browser/request loss. Prompt payload is encrypted;
// each external action uses a stable task/request identity and a fenced DB lease.
model ProjectTaskIntent {
  id String @id @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  requestId String @map("request_id") @db.Uuid
  requestDigest String @map("request_digest")
  repositoryId String @map("repository_id")
  providerAccountId String @map("provider_account_id")
  sourceSha String @map("source_sha")
  phase String @default("queued")
  ciphertext Bytes?
  iv Bytes?
  authTag Bytes? @map("auth_tag")
  status Json?
  leaseId String? @map("lease_id") @db.Uuid
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz
  failureCount Int @default(0) @map("failure_count")
  progressAt DateTime @default(now()) @map("progress_at") @db.Timestamptz
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  project DeliveryProject @relation(fields: [ownerId, projectId], references: [ownerId, id])
  managerBindings DeliveryManagerBinding[]
  @@unique([ownerId, id])
  @@unique([ownerId, projectId, id])
  @@unique([ownerId, projectId, requestId])
  @@index([phase, nextAttemptAt])
  @@map("project_task_intents")
}

// Immutable native checkout identity, independent of manager-selected task IDs
// and short-lived host registration credentials. The intent row serializes all
// lifetimes before one native writer can claim this checkout.
model DeliveryManagerBinding {
  id String @id @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid
  preparationIntentId String @map("preparation_intent_id") @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  buildId String @map("build_id") @db.Uuid
  serverInstanceId String @map("server_instance_id")
  nativeThreadId String @map("native_thread_id")
  repositoryId String @map("repository_id")
  sourceSha String @map("source_sha")
  leaseId String @map("lease_id") @db.Uuid
  leaseGeneration Int @map("lease_generation")
  bindingDigest String @map("binding_digest")
  activeAttemptId String? @map("active_attempt_id") @db.Uuid
  nativeSequence Int @default(0) @map("native_sequence")
  blockedReason String? @map("blocked_reason")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  project DeliveryProject @relation(fields: [ownerId, projectId], references: [ownerId, id])
  preparationIntent ProjectTaskIntent @relation(fields: [ownerId, projectId, preparationIntentId], references: [ownerId, projectId, id], onDelete: Restrict)
  conversation DeliveryConversation @relation(fields: [ownerId, projectId, conversationId], references: [ownerId, projectId, id], onDelete: Restrict)
  activeAttempt DeliveryAttempt? @relation("ActiveManagerAttempt", fields: [ownerId, id, activeAttemptId], references: [ownerId, managerBindingId, id], onDelete: Restrict)
  attempts DeliveryAttempt[] @relation("ManagerAttempt")
  tasks DeliveryTask[]
  @@unique([ownerId, id])
  @@unique([ownerId, projectId, id])
  @@unique([ownerId, bindingDigest])
  @@index([ownerId, preparationIntentId])
  @@map("delivery_manager_bindings")
}
