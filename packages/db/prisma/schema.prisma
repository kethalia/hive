generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NavigationFavoriteKind {
  terminal
  git
}

model User {
  id                           String   @id @default(uuid()) @db.Uuid
  coderUrl                     String   @map("coder_url")
  coderUserId                  String   @map("coder_user_id") @db.Uuid
  username                     String
  email                        String
  emailVerified                Boolean  @default(false) @map("email_verified")
  image                        String?
  authMode                     String   @default("legacy") @map("auth_mode")
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  terminalControlsBeyondMobile Boolean  @default(false) @map("terminal_controls_beyond_mobile")

  coderTokens         CoderToken[]
  sessions            Session[]
  pushSubscriptions   PushSubscription[]
  notificationSources NotificationSource[]
  navigationFavorites NavigationFavorite[]
  oauthAccounts       CoderOAuthAccount[]
  deliveryProjects    DeliveryProject[]
  codexHostSlots      CodexHostSlot[]

  @@unique([coderUrl, coderUserId])
  @@map("users")
}

model CoderToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  ciphertext Bytes
  iv         Bytes
  authTag    Bytes    @map("auth_tag")
  version    Int       @default(1)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  rotationNextAt DateTime @default(now()) @map("rotation_next_at") @db.Timestamptz
  rotationLeaseId String? @map("rotation_lease_id") @db.Uuid
  rotationLeaseUntil DateTime? @map("rotation_lease_until") @db.Timestamptz
  rotationState Json? @map("rotation_state")
  warningNextAt DateTime? @map("warning_next_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@unique([userId])
  @@index([rotationNextAt], map: "coder_tokens_rotation_due_idx")
  @@map("coder_tokens")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @unique @default(uuid()) @map("session_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  authToken String?  @unique @map("auth_token")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id])

  @@map("sessions")
}

model CoderOAuthAccount {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  password              String?
  accessTokenExpiresAt   DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt  DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  version               Int       @default(1)
  refreshState          String    @default("idle") @map("refresh_state")
  refreshHolder         String?   @map("refresh_holder") @db.Uuid
  refreshUntil          DateTime? @map("refresh_until") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@unique([userId, providerId])
  @@map("coder_oauth_accounts")
}

model BAVerification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([identifier])
  @@map("better_auth_verifications")
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String @unique
  preferences Json @default("{}")
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

model NavigationFavorite {
  id           String                 @id @default(uuid()) @db.Uuid
  userId       String                 @map("user_id") @db.Uuid
  kind         NavigationFavoriteKind
  workspaceId  String                 @map("workspace_id")
  targetKey    String                 @map("target_key")
  label        String?
  relativePath String?                @map("relative_path")
  position     Int                    @default(2147483647)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, workspaceId, targetKey])
  @@index([userId, kind, workspaceId])
  @@index([userId, position])
  @@map("navigation_favorites")
}

model VapidKeys {
  id         Int      @id @default(1)
  publicKey  String   @map("public_key")
  privateKey String   @map("private_key")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("vapid_keys")
}

model NotificationSource {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  workspaceName String @map("workspace_name")
  tokenHash String @unique @map("token_hash")
  pendingTokenHash String? @unique @map("pending_token_hash")
  credentialGeneration Int @default(0) @map("credential_generation")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentNotifications AgentNotificationEvent[]
  agentNotificationRateWindow AgentNotificationRateWindow?
  @@unique([userId, id], map: "notification_sources_user_id_id_key")
  @@unique([userId, workspaceId])
  @@map("notification_sources")
}

model AgentNotificationEvent {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  sourceId String @map("source_id") @db.Uuid
  eventId String @unique @map("event_id") @db.Uuid
  eventKey String @map("event_key")
  payload Json
  payloadDigest String @map("payload_digest")
  coderUserId String @map("coder_user_id") @db.Uuid
  coderOrigin String @map("coder_origin")
  channel String @default("push")
  status String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  source NotificationSource @relation(fields: [ownerId, sourceId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction, map: "agent_notification_source_owner_fk")
  @@unique([sourceId, eventKey], map: "agent_notification_event_key")
  @@index([status, nextAttemptAt], map: "agent_notification_events_status_due_idx")
  @@index([ownerId, status, nextAttemptAt], map: "agent_notification_events_owner_due_idx")
  @@index([sourceId, status], map: "agent_notification_events_source_status_idx")
  @@map("agent_notification_events")
}
model AgentNotificationRateWindow {
  sourceId String @id @map("source_id") @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  windowStart DateTime @map("window_start") @db.Timestamptz
  accepted Int
  source NotificationSource @relation(fields: [ownerId, sourceId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction, map: "agent_notification_rate_owner_fk")
  @@unique([ownerId, sourceId], map: "agent_notification_rate_owner_source_key")
  @@map("agent_notification_rate_windows")
}


// Legacy template publication only; no delivery or managed runtime relations.
model TemplateJob {
  id String @id @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  requestId String @map("request_id") @db.Uuid
  coderUserId String @map("coder_user_id") @db.Uuid
  sessionId String @map("session_id") @db.Uuid
  origin String
  organizationId String @map("organization_id") @db.Uuid
  name String
  artifact Json
  state Json
  phase String @default("queued")
  reason String?
  holder String? @db.Uuid
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz
  attempts Int @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  deadline DateTime @db.Timestamptz
  @@unique([ownerId, requestId])
  @@index([phase, nextAttemptAt])
  @@map("template_jobs")
}
model TemplateNotice {
  id String @id @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  jobId String @unique @map("job_id") @db.Uuid
  status String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz
  @@index([status, nextAttemptAt])
  @@map("template_notices")
}

// Request-owned terminal diagnostics shared across Worker isolates.
model TerminalConnection {
  id                 String   @id @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  coderUserId        String   @map("coder_user_id") @db.Uuid
  coderOrigin        String   @map("coder_origin")
  workspaceId        String   @map("workspace_id") @db.Uuid
  buildId            String   @map("build_id") @db.Uuid
  agentId            String   @map("agent_id") @db.Uuid
  sessionName        String   @map("session_name")
  sessionKind        String   @map("session_kind")
  authorityExpiresAt DateTime @map("authority_expires_at") @db.Timestamptz
  leaseUntil         DateTime @map("lease_until") @db.Timestamptz
  health             Json
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz
  closedAt           DateTime? @map("closed_at") @db.Timestamptz
  closeCode          Int?     @map("close_code")
  closeReason        String?  @map("close_reason")

  @@index([userId, coderOrigin, coderUserId, workspaceId, leaseUntil], map: "terminal_connections_owner_workspace_lease_idx")
  @@index([updatedAt])
  @@map("terminal_connections")
}

model TerminalEvent {
  id           BigInt   @id @default(autoincrement())
  userId       String   @map("user_id") @db.Uuid
  coderUserId  String   @map("coder_user_id") @db.Uuid
  coderOrigin  String   @map("coder_origin")
  workspaceId  String   @map("workspace_id") @db.Uuid
  connectionId String   @map("connection_id") @db.Uuid
  sessionName  String   @map("session_name")
  sessionKind  String   @map("session_kind")
  level        String
  type         String
  details      Json
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, id])
  @@index([createdAt])
  @@map("terminal_events")
}

model DeliveryProject {
  id                   String @id @default(uuid()) @db.Uuid
  ownerId              String @map("owner_id") @db.Uuid
  provider             String
  providerRepositoryId String @map("provider_repository_id")
  providerAccountId    String @map("provider_account_id")
  fullName             String @map("full_name")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  owner                User @relation(fields: [ownerId], references: [id])
  conversations        DeliveryConversation[]
  registeredThreads    CodexRegisteredThread[]
  taskIntents          ProjectTaskIntent[]
  epics                DeliveryEpic[]
  tasks                DeliveryTask[]
  managerBindings      DeliveryManagerBinding[]
  guardianAdmissions CodexGuardianAdmission[]
  @@unique([ownerId, id])
  @@unique([ownerId, provider, providerRepositoryId])
  @@map("delivery_projects")
}

model DeliveryConversation {
  id            String @id @default(uuid()) @db.Uuid
  ownerId       String @map("owner_id") @db.Uuid
  projectId     String @map("project_id") @db.Uuid
  workspaceId   String @map("workspace_id") @db.Uuid
  nativeThreadId String @map("native_thread_id")
  buildId       String @map("build_id") @db.Uuid
  serverInstanceId String @map("server_instance_id")
  nativePath    String? @map("native_path")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  project       DeliveryProject @relation(fields: [ownerId, projectId], references: [ownerId, id])
  tasks         DeliveryTask[]
  managerBindings DeliveryManagerBinding[]
  registeredThreads CodexRegisteredThread[]
  @@unique([ownerId, id])
  @@unique([ownerId, projectId, id])
  @@unique([ownerId, workspaceId, nativeThreadId])
  @@map("delivery_conversations")
}

model DeliveryEpic {
  id          String @id @default(uuid()) @db.Uuid
  ownerId     String @map("owner_id") @db.Uuid
  projectId   String @map("project_id") @db.Uuid
  outcome     String
  criteria    Json
  state       String @default("pending")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  project     DeliveryProject @relation(fields: [ownerId, projectId], references: [ownerId, id])
  tasks       DeliveryTask[]
  @@unique([ownerId, id])
  @@unique([ownerId, projectId, id])
  @@map("delivery_epics")
}

model DeliveryTask {
  id               String @id @default(uuid()) @db.Uuid
  ownerId          String @map("owner_id") @db.Uuid
  projectId        String @map("project_id") @db.Uuid
  epicId           String? @map("epic_id") @db.Uuid
  conversationId   String? @map("conversation_id") @db.Uuid
  managerBindingId String? @map("manager_binding_id") @db.Uuid
  outcome          String
  sourceSha        String @map("source_sha")
  sourceRevisionId String? @map("source_revision_id") @db.Uuid
  sourceVersion    Int @default(0) @map("source_version")
  branch           String
  version          Int @default(0)
  pauseRequested   Boolean @default(false) @map("pause_requested")
  schedulingPaused Boolean @default(false) @map("scheduling_paused")
  releaseMode      String @default("disabled") @map("release_mode")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  project          DeliveryProject @relation(fields: [ownerId, projectId], references: [ownerId, id])
  epic             DeliveryEpic? @relation(fields: [ownerId, projectId, epicId], references: [ownerId, projectId, id], onDelete: Restrict)
  conversation     DeliveryConversation? @relation(fields: [ownerId, projectId, conversationId], references: [ownerId, projectId, id], onDelete: Restrict)
  managerBinding   DeliveryManagerBinding? @relation(fields: [ownerId, projectId, managerBindingId], references: [ownerId, projectId, id], onDelete: Restrict)
  steps            DeliveryStep[]
  events           DeliveryEvent[]
  sourceRevisions DeliverySourceRevision[] @relation("TaskSourceRevisions")
  currentSourceRevision DeliverySourceRevision? @relation("CurrentTaskSourceRevision", fields: [ownerId, id, sourceRevisionId], references: [ownerId, taskId, id], onDelete: Restrict)
  @@unique([ownerId, id])
  @@unique([ownerId, id, managerBindingId])
  @@map("delivery_tasks")
}

model DeliveryStep {
  id                    String @id @default(uuid()) @db.Uuid
  ownerId               String @map("owner_id") @db.Uuid
  taskId                String @map("task_id") @db.Uuid
  kind                  String
  acceptancePhase       String @default("implementation_preview") @map("acceptance_phase")
  state                 String @default("pending")
  waitingReason         String? @map("waiting_reason")
  version               Int @default(0)
  reopenGeneration      Int @default(0) @map("reopen_generation")
  leaseGeneration       Int @default(0) @map("lease_generation")
  attemptCount          Int @default(0) @map("attempt_count")
  attemptBudget         Int @default(3) @map("attempt_budget")
  criterionIds          String[] @map("criterion_ids")
  requiredEvidenceKinds String[] @map("required_evidence_kinds")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  task                  DeliveryTask @relation(fields: [ownerId, taskId], references: [ownerId, id])
  attempts              DeliveryAttempt[]
  evidence              DeliveryEvidence[]
  reports               DeliveryStepReport[]
  events                DeliveryEvent[]
  sourceRevisions       DeliverySourceRevision[]
  dependencies          DeliveryStepDependency[] @relation("StepDependencies")
  dependents            DeliveryStepDependency[] @relation("StepDependents")
  @@unique([ownerId, id])
  @@unique([ownerId, taskId, id])
  @@index([ownerId, taskId, state])
  @@map("delivery_steps")
}

model DeliveryStepDependency {
  ownerId         String @map("owner_id") @db.Uuid
  taskId          String @map("task_id") @db.Uuid
  stepId          String @map("step_id") @db.Uuid
  dependsOnStepId String @map("depends_on_step_id") @db.Uuid
  step            DeliveryStep @relation("StepDependencies", fields: [ownerId, taskId, stepId], references: [ownerId, taskId, id], onDelete: Restrict)
  dependsOn       DeliveryStep @relation("StepDependents", fields: [ownerId, taskId, dependsOnStepId], references: [ownerId, taskId, id], onDelete: Restrict)
  @@id([ownerId, taskId, stepId, dependsOnStepId])
  @@map("delivery_step_dependencies")
}

model DeliveryAttempt {
  id               String @id @default(uuid()) @db.Uuid
  ownerId          String @map("owner_id") @db.Uuid
  stepId           String @map("step_id") @db.Uuid
  managerBindingId String? @map("manager_binding_id") @db.Uuid
  leaseGeneration  Int @map("lease_generation")
  leaseHolder      String @map("lease_holder")
  leaseExpiresAt   DateTime @map("lease_expires_at") @db.Timestamptz
  sourceSha        String @map("source_sha")
  outputRevisionId String? @map("output_revision_id") @db.Uuid
  requestedModel   String? @map("requested_model")
  effectiveModel   String? @map("effective_model")
  requestedEffort  String? @map("requested_effort")
  effectiveEffort  String? @map("effective_effort")
  outcome          String @default("running")
  runtimeBinding   Json? @map("runtime_binding")
  runtimeBindingDigest String? @map("runtime_binding_digest")
  runtimeVersion   Int @default(0) @map("runtime_version")
  quiescedAt       DateTime? @map("quiesced_at") @db.Timestamptz
  startedAt        DateTime @default(now()) @map("started_at") @db.Timestamptz
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz
  step             DeliveryStep @relation(fields: [ownerId, stepId], references: [ownerId, id])
  reports          DeliveryStepReport[]
  events           DeliveryEvent[]
  managerBinding   DeliveryManagerBinding? @relation("ManagerAttempt", fields: [ownerId, managerBindingId], references: [ownerId, id], onDelete: Restrict)
  activeForBindings DeliveryManagerBinding[] @relation("ActiveManagerAttempt")
  currentForBindings DeliveryManagerBinding[] @relation("CurrentManagerAttempt")
  producedRevision DeliverySourceRevision? @relation("ProducedSourceRevision")
  outputRevision DeliverySourceRevision? @relation("AttemptOutputRevision", fields: [ownerId, stepId, id, outputRevisionId], references: [ownerId, stepId, producingAttemptId, id], onDelete: Restrict)
  @@unique([ownerId, id])
  @@unique([ownerId, stepId, id])
  @@unique([ownerId, managerBindingId, id])
  @@unique([ownerId, stepId, leaseGeneration])
  @@map("delivery_attempts")
}

model DeliveryEvidence {
  id             String @id @default(uuid()) @db.Uuid
  ownerId        String @map("owner_id") @db.Uuid
  stepId         String @map("step_id") @db.Uuid
  producer       String
  policyVersion  String @map("policy_version")
  remoteId       String @map("remote_id")
  kind           String
  status         String
  verificationMode String @map("verification_mode")
  environment    String
  sourceSha      String @map("source_sha")
  artifactDigest String? @map("artifact_digest")
  criterionIds   String[] @map("criterion_ids")
  objectKey      String @map("object_key")
  contentDigest  String @map("content_digest")
  requestDigest  String @map("request_digest")
  observedAt     DateTime @map("observed_at") @db.Timestamptz
  invalidatedAt  DateTime? @map("invalidated_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  step           DeliveryStep @relation(fields: [ownerId, stepId], references: [ownerId, id])
  reports        DeliveryReportEvidence[]
  @@unique([ownerId, id])
  @@unique([ownerId, stepId, id])
  @@unique([ownerId, stepId, producer, remoteId])
  @@map("delivery_evidence")
}

model DeliveryEvent {
  maintenanceEpochBindings DeliveryManagerBinding[] @relation("MaintenanceResumeIntent")
  id               String @id @db.Uuid
  ownerId          String @map("owner_id") @db.Uuid
  taskId           String @map("task_id") @db.Uuid
  stepId           String? @map("step_id") @db.Uuid
  attemptId        String? @map("attempt_id") @db.Uuid
  aggregateKey     String @map("aggregate_key")
  aggregateVersion Int @map("aggregate_version")
  schemaVersion    Int @default(1) @map("schema_version")
  policyVersion    String @default("disabled-v1") @map("policy_version")
  type             String
  requestDigest    String @map("request_digest")
  payload          Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  task             DeliveryTask @relation(fields: [ownerId, taskId], references: [ownerId, id])
  step             DeliveryStep? @relation(fields: [ownerId, taskId, stepId], references: [ownerId, taskId, id], onDelete: Restrict)
  attempt          DeliveryAttempt? @relation(fields: [ownerId, stepId, attemptId], references: [ownerId, stepId, id], onDelete: Restrict)
  report           DeliveryStepReport?
  outbox           DeliveryOutbox[]
  @@unique([ownerId, id])
  @@unique([ownerId, stepId, id])
  @@unique([ownerId, aggregateKey, aggregateVersion])
  @@index([ownerId, taskId, attemptId, aggregateVersion], map: "delivery_runtime_events_lookup")
  @@map("delivery_events")
}

model DeliveryStepReport {
  id                   String @id @default(uuid()) @db.Uuid
  ownerId              String @map("owner_id") @db.Uuid
  stepId               String @map("step_id") @db.Uuid
  attemptId            String @map("attempt_id") @db.Uuid
  eventId              String @unique @map("event_id") @db.Uuid
  summary              String
  difficulty           String
  difficultyReason     String @map("difficulty_reason")
  issues               Json
  remainingUncertainty String @map("remaining_uncertainty")
  nextAction           String @map("next_action")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  step                 DeliveryStep @relation(fields: [ownerId, stepId], references: [ownerId, id])
  attempt              DeliveryAttempt @relation(fields: [ownerId, stepId, attemptId], references: [ownerId, stepId, id], onDelete: Restrict)
  event                DeliveryEvent @relation(fields: [ownerId, stepId, eventId], references: [ownerId, stepId, id], onDelete: Restrict)
  evidence             DeliveryReportEvidence[]
  @@unique([ownerId, id])
  @@unique([ownerId, stepId, id])
  @@unique([ownerId, eventId])
  @@unique([ownerId, stepId, eventId])
  @@map("delivery_step_reports")
}

model DeliveryReportEvidence {
  ownerId    String @map("owner_id") @db.Uuid
  stepId     String @map("step_id") @db.Uuid
  reportId   String @map("report_id") @db.Uuid
  evidenceId String @map("evidence_id") @db.Uuid
  report     DeliveryStepReport @relation(fields: [ownerId, stepId, reportId], references: [ownerId, stepId, id], onDelete: Restrict)
  evidence   DeliveryEvidence @relation(fields: [ownerId, stepId, evidenceId], references: [ownerId, stepId, id], onDelete: Restrict)
  @@id([ownerId, reportId, evidenceId])
  @@map("delivery_report_evidence")
}

model DeliveryOutbox {
  id            String @id @default(uuid()) @db.Uuid
  ownerId       String @map("owner_id") @db.Uuid
  eventId       String @map("event_id") @db.Uuid
  channel       String @default("push")
  status        String @default("pending")
  attempts      Int @default(0)
