  preparationIntent ProjectTaskIntent @relation(fields: [ownerId, projectId, preparationIntentId], references: [ownerId, projectId, id], onDelete: Restrict)
  conversation DeliveryConversation @relation(fields: [ownerId, projectId, conversationId], references: [ownerId, projectId, id], onDelete: Restrict)
  activeAttempt DeliveryAttempt? @relation("ActiveManagerAttempt", fields: [ownerId, id, activeAttemptId], references: [ownerId, managerBindingId, id], onDelete: Restrict)
  currentAttempt DeliveryAttempt? @relation("CurrentManagerAttempt", fields: [ownerId, id, currentAttemptId], references: [ownerId, managerBindingId, id], onDelete: Restrict, map: "delivery_manager_current_attempt_fkey")
