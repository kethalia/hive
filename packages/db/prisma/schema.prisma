generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NavigationFavoriteKind {
  terminal
  git
}

model User {
  id                           String   @id @default(uuid()) @db.Uuid
  coderUrl                     String   @map("coder_url")
  coderUserId                  String   @map("coder_user_id") @db.Uuid
  username                     String
  email                        String
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  terminalControlsBeyondMobile Boolean  @default(false) @map("terminal_controls_beyond_mobile")

  coderTokens         CoderToken[]
  sessions            Session[]
  pushSubscriptions   PushSubscription[]
  navigationFavorites NavigationFavorite[]

  @@unique([coderUrl, coderUserId])
  @@map("users")
}

model CoderToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  ciphertext Bytes
  iv         Bytes
  authTag    Bytes    @map("auth_tag")
  version    Int       @default(1)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@unique([userId])
  @@map("coder_tokens")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @unique @default(uuid()) @map("session_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("sessions")
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

model NavigationFavorite {
  id           String                 @id @default(uuid()) @db.Uuid
  userId       String                 @map("user_id") @db.Uuid
  kind         NavigationFavoriteKind
  workspaceId  String                 @map("workspace_id")
  targetKey    String                 @map("target_key")
  label        String?
  relativePath String?                @map("relative_path")
  position     Int                    @default(2147483647)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, workspaceId, targetKey])
  @@index([userId, kind, workspaceId])
  @@index([userId, position])
  @@map("navigation_favorites")
}

model VapidKeys {
  id         Int      @id @default(1)
  publicKey  String   @map("public_key")
  privateKey String   @map("private_key")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("vapid_keys")
}
