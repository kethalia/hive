  requestDigest String @map("request_digest")
  repositoryId String @map("repository_id")
  providerAccountId String @map("provider_account_id")
  sourceSha String @map("source_sha")
  phase String @default("queued")
  ciphertext Bytes?
  iv Bytes?
  authTag Bytes? @map("auth_tag")
  status Json?
  leaseId String? @map("lease_id") @db.Uuid
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz
  failureCount Int @default(0) @map("failure_count")
  progressAt DateTime @default(now()) @map("progress_at") @db.Timestamptz
