generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NavigationFavoriteKind {
  terminal
  git
}

model User {
  id                           String   @id @default(uuid()) @db.Uuid
  coderUrl                     String   @map("coder_url")
  coderUserId                  String   @map("coder_user_id") @db.Uuid
  username                     String
  email                        String
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  terminalControlsBeyondMobile Boolean  @default(false) @map("terminal_controls_beyond_mobile")

  templatePublications TemplatePublicationJob[]

  coderTokens         CoderToken[]
  sessions            Session[]
  pushSubscriptions   PushSubscription[]
  notificationSources NotificationSource[]
  navigationFavorites NavigationFavorite[]
  deliveryProjects    DeliveryProject[]
  codexHostSlots      CodexHostSlot[]

  @@unique([coderUrl, coderUserId])
  @@map("users")
}

model TemplatePublicationTarget {
  id               String                   @id @default(uuid()) @db.Uuid
  configuredOrigin String                   @map("configured_origin")
  organizationId   String                   @map("organization_id") @db.Uuid
  organizationName String                   @map("organization_name")
  templateId       String?                  @map("template_id") @db.Uuid
  templateName     String                   @map("template_name")
  currentJobId     String?                  @map("current_job_id") @db.Uuid
  generation       Int                      @default(0)
  heldReason       String?                  @map("held_reason")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  jobs             TemplatePublicationJob[] @relation("PublicationJobs")
  currentJob       TemplatePublicationJob?  @relation("PublicationCurrent", fields: [id, currentJobId], references: [targetId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([configuredOrigin, organizationId, templateId])
  @@unique([configuredOrigin, organizationId, templateName], map: "template_publication_target_name_key")
  @@map("template_publication_targets")
}

model TemplatePublicationJob {
  id                      String                      @id @default(uuid()) @db.Uuid
  ownerId                 String                      @map("owner_id") @db.Uuid
  actorSessionId          String                      @map("actor_session_id") @db.Uuid
  actorCoderUserId        String                      @map("actor_coder_user_id") @db.Uuid
  targetId                String                      @map("target_id") @db.Uuid
  targetGeneration        Int                         @map("target_generation")
  requestId               String                      @map("request_id") @db.Uuid
  requestDigest           String                      @map("request_digest")
  templateName            String                      @map("template_name")
  contentHash             String                      @map("content_hash")
  archiveDigest           String                      @map("archive_digest")
  archiveBytes            Int                         @map("archive_bytes")
  manifestDigest          String                      @map("manifest_digest")
  versionName             String                      @map("version_name")
  expectedActiveVersionId String?                     @map("expected_active_version_id") @db.Uuid
  operationMode           String                      @default("update") @map("operation_mode")
  provisionerTagsDigest   String?                     @map("provisioner_tags_digest")
  stage                   String                      @default("queued")
  effectState             String                      @default("clear") @map("effect_state")
  effectDigest            String?                     @map("effect_digest")
  fileId                  String?                     @map("file_id") @db.Uuid
  versionId               String?                     @map("version_id") @db.Uuid
  importJobId             String?                     @map("import_job_id") @db.Uuid
  remoteStatus            String?                     @map("remote_status")
  remoteLogAfter          BigInt                      @default(0) @map("remote_log_after")
  logsOverflowed          Boolean                     @default(false) @map("logs_overflowed")
  leaseHolder             String?                     @map("lease_holder") @db.Uuid
  leaseGeneration         Int                         @default(0) @map("lease_generation")
  leaseUntil              DateTime?                   @map("lease_until") @db.Timestamptz
  nextAttemptAt           DateTime                    @default(now()) @map("next_attempt_at") @db.Timestamptz
  retries                 Int                         @default(0)
  eventSequence           Int                         @default(0) @map("event_sequence")
  heldReason              String?                     @map("held_reason")
  createdAt               DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime                    @default(now()) @map("updated_at") @db.Timestamptz
  finishedAt              DateTime?                   @map("finished_at") @db.Timestamptz
  owner                   User                        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  target                  TemplatePublicationTarget   @relation("PublicationJobs", fields: [targetId], references: [id], onDelete: Restrict)
  currentFor              TemplatePublicationTarget[] @relation("PublicationCurrent")
  events                  TemplatePublicationEvent[]
  notice                  TemplatePublicationNotice?

  @@unique([ownerId, id])
  @@unique([targetId, id])
  @@unique([ownerId, requestId])
  @@index([stage, nextAttemptAt])
  @@map("template_publication_jobs")
}

model TemplatePublicationEvent {
  id        String                 @id @default(uuid()) @db.Uuid
  ownerId   String                 @map("owner_id") @db.Uuid
  jobId     String                 @map("job_id") @db.Uuid
  sequence  Int
  key       String
  code      String
  data      Json
  digest    String
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz
  job       TemplatePublicationJob @relation(fields: [ownerId, jobId], references: [ownerId, id], onDelete: Restrict, onUpdate: NoAction)
  notice    TemplatePublicationNotice?

  @@unique([ownerId,jobId,id], map:"template_publication_event_notice_key")
  @@unique([jobId, sequence])
  @@unique([jobId, key])
  @@map("template_publication_events")
}

model TemplatePublicationNotice {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  jobId String @unique @map("job_id") @db.Uuid
  eventId String @unique @map("event_id") @db.Uuid
  status String @default("pending")
  attempts Int @default(0)
  leaseHolder String? @map("lease_holder") @db.Uuid
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz
  lastReason String? @map("last_reason")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  finishedAt DateTime? @map("finished_at") @db.Timestamptz
  job TemplatePublicationJob @relation(fields:[ownerId,jobId], references:[ownerId,id],onDelete:Restrict,onUpdate:NoAction)
  event TemplatePublicationEvent @relation(fields:[ownerId,jobId,eventId],references:[ownerId,jobId,id],onDelete:Restrict,onUpdate:NoAction)
  @@unique([ownerId,jobId])
  @@unique([ownerId,jobId,eventId])
  @@index([status,nextAttemptAt])
  @@map("template_publication_notices")
}

model CoderToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  ciphertext Bytes
  iv         Bytes
  authTag    Bytes    @map("auth_tag")
  version    Int       @default(1)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz
  // Only a positively identified key created by Hive; legacy credentials stay null.
  remoteKeyId String? @map("remote_key_id")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])
  rotationOperations CredentialRotationOperation[]
  expiryNotices CredentialExpiryNotice[]

  @@unique([userId])
  @@unique([userId, id])
  @@map("coder_tokens")
}

model CredentialRotationSchedule {
  id String @id @default(uuid()) @db.Uuid
  configuredOrigin String @unique @map("configured_origin")
  afterId String? @map("after_id") @db.Uuid
  holder String? @db.Uuid
  generation Int @default(0)
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz
  nextRunAt DateTime @default(now()) @map("next_run_at") @db.Timestamptz
  sweepStartedAt DateTime? @map("sweep_started_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  operations CredentialRotationOperation[]
  @@map("credential_rotation_schedules")
}

model CredentialRotationOperation {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  tokenId String @map("token_id") @db.Uuid
  tokenVersion Int @map("token_version")
  coderUserId String @map("coder_user_id") @db.Uuid
  configuredOrigin String @map("configured_origin")
  holder String @db.Uuid
  scheduleGeneration Int @map("schedule_generation")
  phase String @default("minting")
  remoteKeyId String? @map("remote_key_id")
  reason String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  finishedAt DateTime? @map("finished_at") @db.Timestamptz
  token CoderToken @relation(fields:[ownerId,tokenId],references:[userId,id],onDelete:Restrict,onUpdate:NoAction)
  schedule CredentialRotationSchedule @relation(fields:[configuredOrigin],references:[configuredOrigin],onDelete:Restrict,onUpdate:NoAction)
  @@unique([tokenId,tokenVersion])
  @@index([phase,createdAt])
  @@map("credential_rotation_operations")
}

model CredentialExpiryNotice {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  tokenId String @map("token_id") @db.Uuid
  tokenVersion Int @map("token_version")
  configuredOrigin String @map("configured_origin")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  status String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  token CoderToken @relation(fields:[ownerId,tokenId],references:[userId,id],onDelete:Restrict,onUpdate:NoAction)
  @@unique([tokenId,tokenVersion])
  @@index([configuredOrigin,status,nextAttemptAt])
  @@map("credential_expiry_notices")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @unique @default(uuid()) @map("session_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("sessions")
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String @unique
  preferences Json @default("{}")
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

model NavigationFavorite {
  id           String                 @id @default(uuid()) @db.Uuid
  userId       String                 @map("user_id") @db.Uuid
  kind         NavigationFavoriteKind
  workspaceId  String                 @map("workspace_id")
  targetKey    String                 @map("target_key")
  label        String?
  relativePath String?                @map("relative_path")
  position     Int                    @default(2147483647)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, workspaceId, targetKey])
  @@index([userId, kind, workspaceId])
  @@index([userId, position])
  @@map("navigation_favorites")
}

model VapidKeys {
  id         Int      @id @default(1)
  publicKey  String   @map("public_key")
  privateKey String   @map("private_key")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("vapid_keys")
}

model NotificationSource {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  workspaceName String @map("workspace_name")
  tokenHash String @unique @map("token_hash")
  pendingTokenHash String? @unique @map("pending_token_hash")
  credentialGeneration Int @default(0) @map("credential_generation")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, workspaceId])
  @@map("notification_sources")
}

// Delivery is additive and separate from the retired task runner. Every child
// relation carries ownerId; repository methods additionally enforce owner access.
model DeliveryProject {
  id                   String @id @default(uuid()) @db.Uuid
  ownerId              String @map("owner_id") @db.Uuid
  provider             String
  providerRepositoryId String @map("provider_repository_id")
  providerAccountId    String @map("provider_account_id")
  fullName             String @map("full_name")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  owner                User @relation(fields: [ownerId], references: [id])
  conversations        DeliveryConversation[]
  registeredThreads    CodexRegisteredThread[]
  taskIntents          ProjectTaskIntent[]
  epics                DeliveryEpic[]
  tasks                DeliveryTask[]
  managerBindings      DeliveryManagerBinding[]
  guardianAdmissions CodexGuardianAdmission[]
  @@unique([ownerId, id])
  @@unique([ownerId, provider, providerRepositoryId])
  @@map("delivery_projects")
}

model DeliveryConversation {
  id            String @id @default(uuid()) @db.Uuid
  ownerId       String @map("owner_id") @db.Uuid
  projectId     String @map("project_id") @db.Uuid
  workspaceId   String @map("workspace_id") @db.Uuid
  nativeThreadId String @map("native_thread_id")
  buildId       String @map("build_id") @db.Uuid
  serverInstanceId String @map("server_instance_id")
  nativePath    String? @map("native_path")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  project       DeliveryProject @relation(fields: [ownerId, projectId], references: [ownerId, id])
  tasks         DeliveryTask[]
  managerBindings DeliveryManagerBinding[]
  registeredThreads CodexRegisteredThread[]
  @@unique([ownerId, id])
  @@unique([ownerId, projectId, id])
  @@unique([ownerId, workspaceId, nativeThreadId])
  @@map("delivery_conversations")
}

model DeliveryEpic {
  id          String @id @default(uuid()) @db.Uuid
  ownerId     String @map("owner_id") @db.Uuid
  projectId   String @map("project_id") @db.Uuid
  outcome     String
  criteria    Json
  state       String @default("pending")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  project     DeliveryProject @relation(fields: [ownerId, projectId], references: [ownerId, id])
  tasks       DeliveryTask[]
  @@unique([ownerId, id])
  @@unique([ownerId, projectId, id])
  @@map("delivery_epics")
}

model DeliveryTask {
  id               String @id @default(uuid()) @db.Uuid
  ownerId          String @map("owner_id") @db.Uuid
  projectId        String @map("project_id") @db.Uuid
  epicId           String? @map("epic_id") @db.Uuid
  conversationId   String? @map("conversation_id") @db.Uuid
  managerBindingId String? @map("manager_binding_id") @db.Uuid
  outcome          String
  sourceSha        String @map("source_sha")
  sourceRevisionId String? @map("source_revision_id") @db.Uuid
  sourceVersion    Int @default(0) @map("source_version")
  branch           String
  version          Int @default(0)
  pauseRequested   Boolean @default(false) @map("pause_requested")
  schedulingPaused Boolean @default(false) @map("scheduling_paused")
  releaseMode      String @default("disabled") @map("release_mode")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  project          DeliveryProject @relation(fields: [ownerId, projectId], references: [ownerId, id])
  epic             DeliveryEpic? @relation(fields: [ownerId, projectId, epicId], references: [ownerId, projectId, id], onDelete: Restrict)
  conversation     DeliveryConversation? @relation(fields: [ownerId, projectId, conversationId], references: [ownerId, projectId, id], onDelete: Restrict)
  managerBinding   DeliveryManagerBinding? @relation(fields: [ownerId, projectId, managerBindingId], references: [ownerId, projectId, id], onDelete: Restrict)
  steps            DeliveryStep[]
  events           DeliveryEvent[]
  sourceRevisions DeliverySourceRevision[] @relation("TaskSourceRevisions")
  sourceApplications DeliverySourceApplication[]
  currentSourceRevision DeliverySourceRevision? @relation("CurrentTaskSourceRevision", fields: [ownerId, id, sourceRevisionId], references: [ownerId, taskId, id], onDelete: Restrict)
  @@unique([ownerId, id])
  @@unique([ownerId, id, managerBindingId])
  @@map("delivery_tasks")
}

model DeliveryStep {
  id                    String @id @default(uuid()) @db.Uuid
  ownerId               String @map("owner_id") @db.Uuid
  taskId                String @map("task_id") @db.Uuid
  kind                  String
  acceptancePhase       String @default("implementation_preview") @map("acceptance_phase")
  state                 String @default("pending")
  waitingReason         String? @map("waiting_reason")
  version               Int @default(0)
  reopenGeneration      Int @default(0) @map("reopen_generation")
  leaseGeneration       Int @default(0) @map("lease_generation")
  attemptCount          Int @default(0) @map("attempt_count")
  attemptBudget         Int @default(3) @map("attempt_budget")
  criterionIds          String[] @map("criterion_ids")
  requiredEvidenceKinds String[] @map("required_evidence_kinds")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  task                  DeliveryTask @relation(fields: [ownerId, taskId], references: [ownerId, id])
  attempts              DeliveryAttempt[]
  evidence              DeliveryEvidence[]
  reports               DeliveryStepReport[]
  events                DeliveryEvent[]
  sourceRevisions       DeliverySourceRevision[]
  dependencies          DeliveryStepDependency[] @relation("StepDependencies")
  dependents            DeliveryStepDependency[] @relation("StepDependents")
  @@unique([ownerId, id])
  @@unique([ownerId, taskId, id])
  @@index([ownerId, taskId, state])
  @@map("delivery_steps")
}

model DeliveryStepDependency {
  ownerId         String @map("owner_id") @db.Uuid
  taskId          String @map("task_id") @db.Uuid
  stepId          String @map("step_id") @db.Uuid
  dependsOnStepId String @map("depends_on_step_id") @db.Uuid
  step            DeliveryStep @relation("StepDependencies", fields: [ownerId, taskId, stepId], references: [ownerId, taskId, id], onDelete: Restrict)
  dependsOn       DeliveryStep @relation("StepDependents", fields: [ownerId, taskId, dependsOnStepId], references: [ownerId, taskId, id], onDelete: Restrict)
  @@id([ownerId, taskId, stepId, dependsOnStepId])
  @@map("delivery_step_dependencies")
}

model DeliveryAttempt {
  id               String @id @default(uuid()) @db.Uuid
  ownerId          String @map("owner_id") @db.Uuid
  stepId           String @map("step_id") @db.Uuid
  managerBindingId String? @map("manager_binding_id") @db.Uuid
  leaseGeneration  Int @map("lease_generation")
  leaseHolder      String @map("lease_holder")
  leaseExpiresAt   DateTime @map("lease_expires_at") @db.Timestamptz
  sourceSha        String @map("source_sha")
  outputRevisionId String? @map("output_revision_id") @db.Uuid
  requestedModel   String? @map("requested_model")
  effectiveModel   String? @map("effective_model")
  requestedEffort  String? @map("requested_effort")
  effectiveEffort  String? @map("effective_effort")
  outcome          String @default("running")
  runtimeBinding   Json? @map("runtime_binding")
  runtimeBindingDigest String? @map("runtime_binding_digest")
  runtimeVersion   Int @default(0) @map("runtime_version")
  quiescedAt       DateTime? @map("quiesced_at") @db.Timestamptz
  startedAt        DateTime @default(now()) @map("started_at") @db.Timestamptz
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz
  step             DeliveryStep @relation(fields: [ownerId, stepId], references: [ownerId, id])
  reports          DeliveryStepReport[]
  events           DeliveryEvent[]
  managerBinding   DeliveryManagerBinding? @relation("ManagerAttempt", fields: [ownerId, managerBindingId], references: [ownerId, id], onDelete: Restrict)
  activeForBindings DeliveryManagerBinding[] @relation("ActiveManagerAttempt")
  currentForBindings DeliveryManagerBinding[] @relation("CurrentManagerAttempt")
  producedRevision DeliverySourceRevision? @relation("ProducedSourceRevision")
  outputRevision DeliverySourceRevision? @relation("AttemptOutputRevision", fields: [ownerId, stepId, id, outputRevisionId], references: [ownerId, stepId, producingAttemptId, id], onDelete: Restrict)
  @@unique([ownerId, id])
  @@unique([ownerId, stepId, id])
  @@unique([ownerId, managerBindingId, id])
  @@unique([ownerId, stepId, leaseGeneration])
  @@map("delivery_attempts")
}

model DeliveryEvidence {
  id             String @id @default(uuid()) @db.Uuid
  ownerId        String @map("owner_id") @db.Uuid
  stepId         String @map("step_id") @db.Uuid
  producer       String
  policyVersion  String @map("policy_version")
  remoteId       String @map("remote_id")
  kind           String
  status         String
  verificationMode String @map("verification_mode")
  environment    String
  sourceSha      String @map("source_sha")
  artifactDigest String? @map("artifact_digest")
  criterionIds   String[] @map("criterion_ids")
  objectKey      String @map("object_key")
  contentDigest  String @map("content_digest")
  requestDigest  String @map("request_digest")
  observedAt     DateTime @map("observed_at") @db.Timestamptz
  invalidatedAt  DateTime? @map("invalidated_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  step           DeliveryStep @relation(fields: [ownerId, stepId], references: [ownerId, id])
  reports        DeliveryReportEvidence[]
  @@unique([ownerId, id])
  @@unique([ownerId, stepId, id])
  @@unique([ownerId, stepId, producer, remoteId])
  @@map("delivery_evidence")
}

model DeliveryEvent {
  id               String @id @db.Uuid
  ownerId          String @map("owner_id") @db.Uuid
  taskId           String @map("task_id") @db.Uuid
  stepId           String? @map("step_id") @db.Uuid
  attemptId        String? @map("attempt_id") @db.Uuid
  aggregateKey     String @map("aggregate_key")
  aggregateVersion Int @map("aggregate_version")
  schemaVersion    Int @default(1) @map("schema_version")
  policyVersion    String @default("disabled-v1") @map("policy_version")
  type             String
  requestDigest    String @map("request_digest")
  payload          Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  task             DeliveryTask @relation(fields: [ownerId, taskId], references: [ownerId, id])
  step             DeliveryStep? @relation(fields: [ownerId, taskId, stepId], references: [ownerId, taskId, id], onDelete: Restrict)
  attempt          DeliveryAttempt? @relation(fields: [ownerId, stepId, attemptId], references: [ownerId, stepId, id], onDelete: Restrict)
  report           DeliveryStepReport?
  outbox           DeliveryOutbox[]
  @@unique([ownerId, id])
  @@unique([ownerId, stepId, id])
  @@unique([ownerId, aggregateKey, aggregateVersion])
  @@index([ownerId, taskId, attemptId, aggregateVersion], map: "delivery_runtime_events_lookup")
  @@map("delivery_events")
}

model DeliveryStepReport {
  id                   String @id @default(uuid()) @db.Uuid
  ownerId              String @map("owner_id") @db.Uuid
  stepId               String @map("step_id") @db.Uuid
  attemptId            String @map("attempt_id") @db.Uuid
  eventId              String @unique @map("event_id") @db.Uuid
  summary              String
  difficulty           String
  difficultyReason     String @map("difficulty_reason")
  issues               Json
  remainingUncertainty String @map("remaining_uncertainty")
  nextAction           String @map("next_action")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  step                 DeliveryStep @relation(fields: [ownerId, stepId], references: [ownerId, id])
  attempt              DeliveryAttempt @relation(fields: [ownerId, stepId, attemptId], references: [ownerId, stepId, id], onDelete: Restrict)
  event                DeliveryEvent @relation(fields: [ownerId, stepId, eventId], references: [ownerId, stepId, id], onDelete: Restrict)
  evidence             DeliveryReportEvidence[]
  @@unique([ownerId, id])
  @@unique([ownerId, stepId, id])
  @@unique([ownerId, eventId])
  @@unique([ownerId, stepId, eventId])
  @@map("delivery_step_reports")
}

model DeliveryReportEvidence {
  ownerId    String @map("owner_id") @db.Uuid
  stepId     String @map("step_id") @db.Uuid
  reportId   String @map("report_id") @db.Uuid
  evidenceId String @map("evidence_id") @db.Uuid
