  applicationVersion Int @map("application_version")
  predecessorHeadSha String @map("predecessor_head_sha")
  targetHeadSha String @map("target_head_sha")
  metadataPinsDigest String @map("metadata_pins_digest")
  namespaceReceiptDigest String @map("namespace_receipt_digest")
  cursorVersion Int @map("cursor_version")
  nativeSequence Int @map("native_sequence")
  idleSnapshotDigest String @map("idle_snapshot_digest")
