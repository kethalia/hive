#!/bin/sh
# Terraform supplies only public configuration and the template-pinned package.
# Keep the large payload on stdin, outside argv/env limits and log output.
set -eu
set +x
test "$HIVE_WORKSPACE_PROFILE" = software
/usr/bin/python3 -c 'import base64; exec(compile(base64.b64decode("${installer_base64}"), "installed-codex-host", "exec"))' <<'HIVE_HOST_INSTALL_REQUEST'
${request_json}
HIVE_HOST_INSTALL_REQUEST
