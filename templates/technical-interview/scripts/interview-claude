#!/usr/bin/python3 -I
# hive-managed-interview-claude:v5
"""Bridge a Coder command app to a shell-inaccessible Claude runtime."""

import ctypes
import errno
import fcntl
import http.client
import http.server
import os
import pty
import re
import select
import shutil
import signal
import socket
import socketserver
import ssl
import stat
import struct
import subprocess
import sys
import termios
import threading
import tempfile
import tty
import urllib.parse
from pathlib import Path
from typing import NoReturn


PR_SET_DUMPABLE = 4
TIOCEXCL = getattr(termios, "TIOCEXCL", 0x540C)
TIOCNXCL = getattr(termios, "TIOCNXCL", 0x540D)
TIOCSCTTY = getattr(termios, "TIOCSCTTY", 0x540E)
INTERVIEW_REPOSITORY = Path("/workspace/projects/prmsolutions/interview-template")
INTERVIEW_HOME = Path("/home/coder")
EXPECTED_ORIGINS = {
    "https://github.com/prmsolutions/interview-template",
    "https://github.com/prmsolutions/interview-template.git",
}
TRUSTED_CLAUDE = Path("/opt/hive-interview-tools/claude")
TRUSTED_GUARD = Path("/opt/hive-interview-tools/claude-guard.so")
ANTHROPIC_UPSTREAM_HOST = "api.anthropic.com"
ANTHROPIC_UPSTREAM_PORT = 443
ANTHROPIC_UPSTREAM_TLS = True
BROKER_PLACEHOLDER_KEY = "hive-interview-broker-managed-non-secret"
BROKER_REDIRECT_PORT = 43117
MAX_REQUEST_BYTES = 64 * 1024 * 1024
MAX_LAUNCH_ARGUMENTS = 128
MAX_LAUNCH_ARGUMENT_BYTES = 64 * 1024
MAX_LAUNCH_KEY_BYTES = 16 * 1024
MAX_FRAME_BYTES = 1024 * 1024
LAUNCH_PROTOCOL_MAGIC = b"HIVECLAUDEv5\0\0\0\0"
LAUNCH_REQUEST_HEADER = struct.Struct("!16sIIIHH")
FRAME_HEADER = struct.Struct("!BI")
FRAME_INPUT = 1
FRAME_RESIZE = 2
FRAME_OUTPUT = 3
FRAME_EXIT = 4
FRAME_ERROR = 5
CLIENT_UID = 1000
CLIENT_GID = 1000
PROTECTED_RUNTIME_UID = 1000
ALLOWED_ANTHROPIC_REQUESTS = {
    ("GET", "/v1/models"),
    ("POST", "/v1/messages"),
    ("POST", "/v1/messages/count_tokens"),
}
HOP_BY_HOP_HEADERS = {
    "connection",
    "expect",
    "keep-alive",
    "proxy-authenticate",
    "proxy-authorization",
    "te",
    "trailer",
    "transfer-encoding",
    "upgrade",
}
UNSAFE_GIT_CONFIG = re.compile(
    r"^(credential($|\.)|http\..*(extraheader|proxy|cookiefile|savecookies|sslcert|sslkey)$|"
    r"core\.(attributesfile|fsmonitor|gitproxy|sshcommand)$|"
    r"filter\..*\.(clean|process|smudge)$|diff\..*\.(command|textconv)$|"
    r"remote\..*\.proxy$|url\..*\.insteadof$|include($|\.)|includeif\.)",
    re.IGNORECASE,
)


def fail(message: str) -> NoReturn:
    print(f"[error] {message}", file=sys.stderr)
    raise SystemExit(1)


def make_process_nondumpable() -> None:
    libc = ctypes.CDLL(None, use_errno=True)
    libc.prctl.argtypes = [
        ctypes.c_int,
        ctypes.c_ulong,
        ctypes.c_ulong,
        ctypes.c_ulong,
        ctypes.c_ulong,
    ]
    libc.prctl.restype = ctypes.c_int
    if libc.prctl(PR_SET_DUMPABLE, 0, 0, 0, 0) != 0:
        fail("Unable to establish the protected Claude credential broker.")


def regular_executable(path: Path) -> bool:
    try:
        metadata = path.lstat()
    except OSError:
        return False
    return stat.S_ISREG(metadata.st_mode) and bool(metadata.st_mode & 0o111)


def safe_environment() -> dict[str, str]:
    environment = {
        "GIT_ASKPASS": "/bin/false",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_SSH_COMMAND": "/bin/false",
        "GIT_TERMINAL_PROMPT": "0",
        "HOME": str(INTERVIEW_HOME),
        "LANG": "C.UTF-8",
        "LOGNAME": "coder",
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "SHELL": "/bin/bash",
        "SSH_ASKPASS": "/bin/false",
        "USER": "coder",
    }
    term = os.environ.get("TERM", "xterm-256color")
    if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9+._-]{0,63}", term):
        environment["TERM"] = term
    else:
        environment["TERM"] = "xterm-256color"
    return environment


def verify_repository(environment: dict[str, str]) -> None:
    git_directory = INTERVIEW_REPOSITORY / ".git"
    git_config = git_directory / "config"
    try:
        git_directory_metadata = git_directory.lstat()
        git_config_metadata = git_config.lstat()
    except OSError:
        fail("Expected interview repository is unavailable.")
    if not stat.S_ISDIR(git_directory_metadata.st_mode) or not stat.S_ISREG(
        git_config_metadata.st_mode
    ):
        fail("Expected interview repository is unavailable.")

    names = subprocess.run(
        [
            "/usr/bin/git",
            "config",
            "--file",
            str(git_config),
            "--no-includes",
            "--name-only",
            "--list",
        ],
        check=False,
        capture_output=True,
        env=environment,
        text=True,
        timeout=10,
    )
    if names.returncode != 0:
        fail("Expected interview repository Git configuration is unreadable.")
    if any(UNSAFE_GIT_CONFIG.search(name) for name in names.stdout.splitlines()):
        fail("Expected interview repository contains unsafe Git transport configuration.")

    origin = subprocess.run(
        [
            "/usr/bin/git",
            "config",
            "--file",
            str(git_config),
            "--no-includes",
            "--get",
            "remote.origin.url",
        ],
        check=False,
        capture_output=True,
        env=environment,
        text=True,
        timeout=10,
    )
    if origin.returncode != 0 or origin.stdout.strip() not in EXPECTED_ORIGINS:
        fail("Expected interview repository has the wrong origin.")


def open_protected_terminal() -> int:
    try:
        terminal = os.open("/dev/tty", os.O_RDWR)
    except OSError:
        fail("A controlling terminal is required for masked API-key input.")

    try:
        fcntl.ioctl(terminal, TIOCEXCL)
        termios.tcgetattr(terminal)
    except OSError:
        os.close(terminal)
        fail("Unable to protect the terminal for masked API-key input.")
    return terminal


def close_protected_terminal(terminal: int) -> None:
    try:
        fcntl.ioctl(terminal, TIOCNXCL)
    except OSError:
        pass
    os.close(terminal)


def read_temporary_key(terminal: int) -> bytearray:
    original = None
    key_bytes = bytearray()
    try:
        original = termios.tcgetattr(terminal)
        masked = termios.tcgetattr(terminal)
        masked[3] &= ~termios.ECHO
        try:
            termios.tcsetattr(terminal, termios.TCSADRAIN, masked)
            os.write(terminal, b"Temporary Anthropic API key: ")
            while len(key_bytes) <= 16_384:
                character = os.read(terminal, 1)
                if not character or character in {b"\r", b"\n"}:
                    break
                key_bytes.extend(character)
            else:
                fail("The temporary API key is unexpectedly long.")
        finally:
            if original is not None:
                termios.tcsetattr(terminal, termios.TCSADRAIN, original)
                os.write(terminal, b"\n")
    except OSError:
        fail("Unable to read the temporary API key securely.")
    if not key_bytes:
        fail("No API key was provided.")
    if any(character < 0x21 or character > 0x7E for character in key_bytes):
        fail("The temporary API key contains invalid characters.")
    return key_bytes


class AnthropicBroker(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    allow_reuse_address = False
    daemon_threads = True

    def __init__(self, api_key: bytearray, socket_path: Path) -> None:
        super().__init__(str(socket_path), AnthropicBrokerHandler)
        self.api_key = api_key
        self.claude_pid: int | None = None


class AnthropicBrokerHandler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.0"
    server_version = "HiveInterviewBroker"
    sys_version = ""

    def log_message(self, _format: str, *_arguments: object) -> None:
        return

    def do_GET(self) -> None:
        self.forward_request()

    def do_POST(self) -> None:
        self.forward_request()

    def do_CONNECT(self) -> None:
        self.send_error(405, "CONNECT is not permitted")

    def forward_request(self) -> None:
        peer_credentials = self.connection.getsockopt(
            socket.SOL_SOCKET,
            socket.SO_PEERCRED,
            struct.calcsize("3i"),
        )
        peer_pid, _peer_uid, _peer_gid = struct.unpack("3i", peer_credentials)
        if self.server.claude_pid is None or peer_pid != self.server.claude_pid:
            self.send_error(403, "Only the protected Claude process may use this broker")
            return

        parsed = urllib.parse.urlsplit(self.path)
        if (
            parsed.scheme
            or parsed.netloc
            or (self.command, parsed.path) not in ALLOWED_ANTHROPIC_REQUESTS
        ):
            self.send_error(403, "Only required Anthropic API requests are permitted")
            return
        if self.headers.get("Transfer-Encoding") is not None:
            self.send_error(400, "Transfer-Encoding is not supported")
            return
        content_lengths = self.headers.get_all("Content-Length", failobj=[])
        if len(content_lengths) > 1:
            self.send_error(400, "Ambiguous Content-Length")
            return
        try:
            content_length = int(content_lengths[0]) if content_lengths else 0
        except ValueError:
            self.send_error(400, "Invalid Content-Length")
            return
        if content_length < 0 or content_length > MAX_REQUEST_BYTES:
            self.send_error(413, "Request body is too large")
            return
        request_body = self.rfile.read(content_length)
        if len(request_body) != content_length:
            self.send_error(400, "Incomplete request body")
            return

        forwarded_headers: dict[str, str] = {}
        for name, value in self.headers.items():
            lowered = name.lower()
            if (
                lowered in HOP_BY_HOP_HEADERS
                or lowered in {"authorization", "content-length", "host", "x-api-key"}
                or lowered.startswith("x-forwarded-")
            ):
                continue
            forwarded_headers[name] = value
        forwarded_headers["Host"] = ANTHROPIC_UPSTREAM_HOST
        forwarded_headers["X-Api-Key"] = bytes(self.server.api_key).decode("ascii")
        forwarded_headers["Content-Length"] = str(content_length)

        if ANTHROPIC_UPSTREAM_TLS:
            connection = http.client.HTTPSConnection(
                ANTHROPIC_UPSTREAM_HOST,
                ANTHROPIC_UPSTREAM_PORT,
                timeout=660,
                context=ssl.create_default_context(),
            )
        else:
            connection = http.client.HTTPConnection(
                ANTHROPIC_UPSTREAM_HOST,
                ANTHROPIC_UPSTREAM_PORT,
                timeout=660,
            )
        response_started = False
        try:
            target = urllib.parse.urlunsplit(("", "", parsed.path, parsed.query, ""))
            connection.request(
                self.command,
                target,
                body=request_body,
                headers=forwarded_headers,
            )
            response = connection.getresponse()
            self.send_response_only(response.status, response.reason)
            for name, value in response.getheaders():
                if name.lower() not in HOP_BY_HOP_HEADERS:
                    self.send_header(name, value)
            self.send_header("Connection", "close")
            self.end_headers()
            response_started = True
            while True:
                chunk = response.read(64 * 1024)
                if not chunk:
                    break
                self.wfile.write(chunk)
                self.wfile.flush()
        except (OSError, http.client.HTTPException, ssl.SSLError):
            if not response_started and not self.wfile.closed:
                self.send_error(502, "Anthropic API request failed")
        finally:
            connection.close()
            self.close_connection = True


def private_broker_socket() -> tuple[Path, Path]:
    configuration_directory = INTERVIEW_HOME / ".claude"
    try:
        metadata = configuration_directory.lstat()
    except OSError:
        fail("The isolated Claude configuration directory is unavailable.")
    if not stat.S_ISDIR(metadata.st_mode):
        fail("The isolated Claude configuration directory is unsafe.")
    try:
        broker_directory = Path(
            tempfile.mkdtemp(prefix=".hive-interview-broker.", dir=configuration_directory)
        )
    except OSError:
        fail("Unable to create the private Anthropic broker socket directory.")
    return broker_directory, broker_directory / "anthropic.sock"


def wipe(secret: bytearray) -> None:
    for index in range(len(secret)):
        secret[index] = 0


def receive_exact(connection: socket.socket, size: int) -> bytes:
    payload = bytearray(size)
    view = memoryview(payload)
    received = 0
    while received < size:
        count = connection.recv_into(view[received:])
        if count == 0:
            raise EOFError("launch connection closed")
        received += count
    return bytes(payload)


def receive_secret(connection: socket.socket, size: int) -> bytearray:
    secret = bytearray(size)
    view = memoryview(secret)
    received = 0
    while received < size:
        count = connection.recv_into(view[received:])
        if count == 0:
            wipe(secret)
            raise EOFError("launch connection closed")
        received += count
    return secret


def send_frame(connection: socket.socket, frame_type: int, payload: bytes = b"") -> None:
    if len(payload) > MAX_FRAME_BYTES:
        raise ValueError("launch frame is too large")
    connection.sendall(FRAME_HEADER.pack(frame_type, len(payload)))
    if payload:
        connection.sendall(payload)


def receive_frame(connection: socket.socket) -> tuple[int, bytes]:
    frame_type, length = FRAME_HEADER.unpack(receive_exact(connection, FRAME_HEADER.size))
    if length > MAX_FRAME_BYTES:
        raise ValueError("launch frame is too large")
    return frame_type, receive_exact(connection, length)


def terminal_size(terminal: int) -> tuple[int, int]:
    try:
        rows, columns, _x_pixels, _y_pixels = struct.unpack(
            "HHHH",
            fcntl.ioctl(terminal, termios.TIOCGWINSZ, b"\0" * 8),
        )
    except OSError:
        return 24, 80
    return max(rows, 1), max(columns, 1)


def apply_terminal_size(terminal: int, rows: int, columns: int) -> None:
    fcntl.ioctl(
        terminal,
        termios.TIOCSWINSZ,
        struct.pack("HHHH", max(rows, 1), max(columns, 1), 0, 0),
    )


def parse_launch_request(
    connection: socket.socket,
) -> tuple[list[str], bytearray, int, int]:
    header = receive_exact(connection, LAUNCH_REQUEST_HEADER.size)
    magic, key_length, argument_count, argument_bytes, rows, columns = (
        LAUNCH_REQUEST_HEADER.unpack(header)
    )
    if magic != LAUNCH_PROTOCOL_MAGIC:
        raise ValueError("invalid launch protocol")
    if key_length == 0 or key_length > MAX_LAUNCH_KEY_BYTES:
        raise ValueError("invalid launch credential")
    if argument_count > MAX_LAUNCH_ARGUMENTS or argument_bytes > MAX_LAUNCH_ARGUMENT_BYTES:
        raise ValueError("invalid launch arguments")

    key = receive_secret(connection, key_length)
    try:
        if any(character < 0x21 or character > 0x7E for character in key):
            raise ValueError("invalid launch credential")
        arguments: list[str] = []
        consumed = 0
        for _index in range(argument_count):
            encoded_length = struct.unpack("!I", receive_exact(connection, 4))[0]
            consumed += 4 + encoded_length
            if encoded_length > MAX_LAUNCH_ARGUMENT_BYTES or consumed > argument_bytes:
                raise ValueError("invalid launch arguments")
            encoded = receive_exact(connection, encoded_length)
            if b"\0" in encoded:
                raise ValueError("invalid launch arguments")
            arguments.append(encoded.decode("utf-8"))
        if consumed != argument_bytes:
            raise ValueError("invalid launch arguments")
        return arguments, key, max(rows, 1), max(columns, 1)
    except (UnicodeDecodeError, ValueError):
        wipe(key)
        raise


def terminate_process_group(process: subprocess.Popen[bytes]) -> None:
    if process.poll() is not None:
        return
    try:
        os.killpg(process.pid, signal.SIGTERM)
        process.wait(timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except OSError:
            pass
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            pass


def protected_claude_session(
    connection: socket.socket,
    arguments: list[str],
    key: bytearray,
    rows: int,
    columns: int,
) -> int:
    environment = safe_environment()
    verify_repository(environment)
    if not regular_executable(TRUSTED_CLAUDE) or not regular_executable(TRUSTED_GUARD):
        fail("The read-only image-baked Claude Code executable is unavailable.")

    broker_directory, broker_socket = private_broker_socket()
    try:
        broker = AnthropicBroker(key, broker_socket)
        os.chmod(broker_socket, 0o600)
    except OSError:
        shutil.rmtree(broker_directory, ignore_errors=True)
        fail("Unable to establish the protected Anthropic credential broker.")

    environment["ANTHROPIC_API_KEY"] = BROKER_PLACEHOLDER_KEY
    environment["ANTHROPIC_BASE_URL"] = f"http://127.0.0.1:{BROKER_REDIRECT_PORT}"
    # The trusted whitelist already excludes every credential, and the preload
    # guard removes the broker route before Claude can exec a child. Forcing
    # Claude's optional bwrap-based scrub would make the pinned rollout image
    # refuse to start because that image intentionally has no bubblewrap.
    environment["CLAUDE_CODE_SUBPROCESS_ENV_SCRUB"] = "0"
    environment["HIVE_INTERVIEW_BROKER_PORT"] = str(BROKER_REDIRECT_PORT)
    environment["HIVE_INTERVIEW_BROKER_SOCKET"] = str(broker_socket)
    environment["LD_PRELOAD"] = str(TRUSTED_GUARD)
    broker_thread: threading.Thread | None = None
    process: subprocess.Popen[bytes] | None = None
    master_terminal = -1
    slave_terminal = -1
    client_connected = True
    terminal_open = True
    try:
        master_terminal, slave_terminal = pty.openpty()
        apply_terminal_size(slave_terminal, rows, columns)

        def establish_controlling_terminal() -> None:
            os.setsid()
            fcntl.ioctl(slave_terminal, TIOCSCTTY, 0)

        try:
            process = subprocess.Popen(
                [str(TRUSTED_CLAUDE), *arguments],
                cwd=INTERVIEW_REPOSITORY,
                env=environment,
                stdin=slave_terminal,
                stdout=slave_terminal,
                stderr=slave_terminal,
                close_fds=True,
                preexec_fn=establish_controlling_terminal,
            )
        except OSError:
            fail("Unable to execute the read-only Claude Code binary.")
        os.close(slave_terminal)
        slave_terminal = -1

        broker.claude_pid = process.pid
        broker_thread = threading.Thread(target=broker.serve_forever, daemon=True)
        broker_thread.start()

        while True:
            try:
                monitored = [connection]
                if terminal_open:
                    monitored.append(master_terminal)
                readable, _writable, _exceptional = select.select(monitored, [], [], 0.1)
            except InterruptedError:
                continue

            if master_terminal in readable:
                try:
                    output = os.read(master_terminal, 64 * 1024)
                except OSError as error:
                    if error.errno != errno.EIO:
                        raise
                    output = b""
                if output:
                    try:
                        send_frame(connection, FRAME_OUTPUT, output)
                    except (BrokenPipeError, ConnectionError, EOFError):
                        client_connected = False
                        break
                else:
                    terminal_open = False

            if connection in readable:
                try:
                    frame_type, payload = receive_frame(connection)
                except (BrokenPipeError, ConnectionError, EOFError):
                    client_connected = False
                    break
                if frame_type == FRAME_INPUT:
                    os.write(master_terminal, payload)
                elif frame_type == FRAME_RESIZE and len(payload) == 4:
                    next_rows, next_columns = struct.unpack("!HH", payload)
                    apply_terminal_size(master_terminal, next_rows, next_columns)
                else:
                    raise ValueError("invalid client launch frame")

            if process.poll() is not None and (
                not terminal_open or master_terminal not in readable
            ):
                break

        if not client_connected:
            terminate_process_group(process)
        return_code = process.wait()
        return return_code if return_code >= 0 else 128 - return_code
    finally:
        if process is not None:
            terminate_process_group(process)
        if slave_terminal >= 0:
            os.close(slave_terminal)
        if master_terminal >= 0:
            os.close(master_terminal)
        if broker_thread is not None:
            broker.shutdown()
        broker.server_close()
        if broker_thread is not None:
            broker_thread.join(timeout=5)
        shutil.rmtree(broker_directory, ignore_errors=True)
        wipe(key)


def handle_launch_connection(connection: socket.socket) -> None:
    peer_credentials = connection.getsockopt(
        socket.SOL_SOCKET,
        socket.SO_PEERCRED,
        struct.calcsize("3i"),
    )
    _peer_pid, peer_uid, peer_gid = struct.unpack("3i", peer_credentials)
    if peer_uid != CLIENT_UID or peer_gid != CLIENT_GID:
        send_frame(connection, FRAME_ERROR, b"Unauthorized Claude launch client.")
        return

    key: bytearray | None = None
    try:
        arguments, key, rows, columns = parse_launch_request(connection)
        return_code = protected_claude_session(connection, arguments, key, rows, columns)
        key = None
        send_frame(connection, FRAME_EXIT, struct.pack("!i", return_code))
    except (EOFError, OSError, ValueError):
        try:
            send_frame(connection, FRAME_ERROR, b"Protected Claude launch failed.")
        except (BrokenPipeError, ConnectionError, OSError):
            pass
    finally:
        if key is not None:
            wipe(key)


def serve_launch_socket(socket_path: Path) -> NoReturn:
    try:
        parent_metadata = socket_path.parent.lstat()
    except OSError:
        fail("The protected Claude launch volume is unavailable.")
    if not stat.S_ISDIR(parent_metadata.st_mode) or socket_path.parent.is_symlink():
        fail("The protected Claude launch volume is unsafe.")

    try:
        existing = socket_path.lstat()
    except FileNotFoundError:
        existing = None
    except OSError:
        fail("The protected Claude launch socket is unsafe.")
    if existing is not None:
        if not stat.S_ISSOCK(existing.st_mode) or existing.st_uid != os.getuid():
            fail("The protected Claude launch socket is unsafe.")
        socket_path.unlink()

    listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        listener.bind(str(socket_path))
        os.chmod(socket_path, 0o660)
        listener.listen(4)
        while True:
            connection, _address = listener.accept()
            with connection:
                handle_launch_connection(connection)
    finally:
        listener.close()
        try:
            metadata = socket_path.lstat()
            if stat.S_ISSOCK(metadata.st_mode) and metadata.st_uid == os.getuid():
                socket_path.unlink()
        except OSError:
            pass
    raise SystemExit(1)


def send_launch_request(
    connection: socket.socket,
    arguments: list[str],
    key: bytearray,
    rows: int,
    columns: int,
) -> None:
    if len(arguments) > MAX_LAUNCH_ARGUMENTS:
        fail("Too many Claude arguments were provided.")
    encoded_arguments = []
    argument_bytes = 0
    for argument in arguments:
        try:
            encoded = argument.encode("utf-8")
        except UnicodeEncodeError:
            fail("Claude arguments must be valid UTF-8.")
        if b"\0" in encoded:
            fail("Claude arguments may not contain null bytes.")
        argument_bytes += 4 + len(encoded)
        if argument_bytes > MAX_LAUNCH_ARGUMENT_BYTES:
            fail("Claude arguments are unexpectedly large.")
        encoded_arguments.append(encoded)

    connection.sendall(
        LAUNCH_REQUEST_HEADER.pack(
            LAUNCH_PROTOCOL_MAGIC,
            len(key),
            len(encoded_arguments),
            argument_bytes,
            rows,
            columns,
        )
    )
    connection.sendall(key)
    for encoded in encoded_arguments:
        connection.sendall(struct.pack("!I", len(encoded)))
        connection.sendall(encoded)


def run_launch_client(socket_path: Path, arguments: list[str]) -> int:
    try:
        socket_metadata = socket_path.lstat()
    except OSError:
        fail("The protected Claude runtime is not ready. Retry in a few seconds.")
    if not stat.S_ISSOCK(socket_metadata.st_mode) or socket_metadata.st_uid != PROTECTED_RUNTIME_UID:
        fail("The protected Claude launch socket is unsafe.")

    connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    terminal = -1
    key: bytearray | None = None
    original_terminal = None
    original_winch_handler = None
    try:
        connection.settimeout(10)
        connection.connect(str(socket_path))
        peer_credentials = connection.getsockopt(
            socket.SOL_SOCKET,
            socket.SO_PEERCRED,
            struct.calcsize("3i"),
        )
        _peer_pid, peer_uid, _peer_gid = struct.unpack("3i", peer_credentials)
        if peer_uid != PROTECTED_RUNTIME_UID:
            fail("The protected Claude runtime identity is invalid.")
        connection.settimeout(None)

        terminal = open_protected_terminal()
        key = read_temporary_key(terminal)
        rows, columns = terminal_size(terminal)
        send_launch_request(connection, arguments, key, rows, columns)
        wipe(key)
        key = None

        original_terminal = termios.tcgetattr(terminal)
        tty.setraw(terminal, termios.TCSADRAIN)
        resize_pending = [False]

        def request_resize(_signum: int, _frame: object) -> None:
            resize_pending[0] = True

        original_winch_handler = signal.signal(signal.SIGWINCH, request_resize)
        while True:
            if resize_pending[0]:
                resize_pending[0] = False
                next_rows, next_columns = terminal_size(terminal)
                send_frame(connection, FRAME_RESIZE, struct.pack("!HH", next_rows, next_columns))

            try:
                readable, _writable, _exceptional = select.select(
                    [terminal, connection], [], [], 0.25
                )
            except InterruptedError:
                continue
            if terminal in readable:
                terminal_input = os.read(terminal, 64 * 1024)
                if not terminal_input:
                    return 1
                send_frame(connection, FRAME_INPUT, terminal_input)
            if connection in readable:
                frame_type, payload = receive_frame(connection)
                if frame_type == FRAME_OUTPUT:
                    os.write(terminal, payload)
                elif frame_type == FRAME_EXIT and len(payload) == 4:
                    return_code = struct.unpack("!i", payload)[0]
                    return return_code if return_code >= 0 else 128 - return_code
                elif frame_type == FRAME_ERROR:
                    os.write(terminal, b"\r\n[error] " + payload + b"\r\n")
                    return 1
                else:
                    fail("The protected Claude runtime returned an invalid response.")
    except (BrokenPipeError, ConnectionError, EOFError, OSError):
        fail("The protected Claude runtime connection was interrupted.")
    finally:
        if original_winch_handler is not None:
            signal.signal(signal.SIGWINCH, original_winch_handler)
        if original_terminal is not None and terminal >= 0:
            try:
                termios.tcsetattr(terminal, termios.TCSADRAIN, original_terminal)
            except OSError:
                pass
        if key is not None:
            wipe(key)
        if terminal >= 0:
            close_protected_terminal(terminal)
        connection.close()
    return 1


def main() -> None:
    make_process_nondumpable()
    if len(sys.argv) < 3 or sys.argv[1] not in {"--client", "--serve"}:
        fail("This launcher may only run as the managed Claude client or runtime service.")

    socket_path = Path(sys.argv[2])
    if not socket_path.is_absolute():
        fail("The protected Claude launch socket path must be absolute.")
    if sys.argv[1] == "--serve":
        if len(sys.argv) != 3:
            fail("The protected Claude runtime service does not accept arguments.")
        serve_launch_socket(socket_path)

    arguments = sys.argv[3:]
    if arguments[:1] == ["--"]:
        arguments = arguments[1:]
    raise SystemExit(run_launch_client(socket_path, arguments))


if __name__ == "__main__":
    main()
