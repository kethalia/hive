def fail(message: str) -> NoReturn:
    print(f"[error] {message}", file=sys.stderr)
    raise SystemExit(1)


def make_process_nondumpable() -> None:
    libc = ctypes.CDLL(None, use_errno=True)
    libc.prctl.argtypes = [
        ctypes.c_int,
        ctypes.c_ulong,
        ctypes.c_ulong,
        ctypes.c_ulong,
        ctypes.c_ulong,
    ]
    libc.prctl.restype = ctypes.c_int
    if libc.prctl(PR_SET_DUMPABLE, 0, 0, 0, 0) != 0:
        fail("Unable to establish the protected Claude credential broker.")


def regular_executable(path: Path) -> bool:
    try:
        metadata = path.lstat()
    except OSError:
        return False
    return stat.S_ISREG(metadata.st_mode) and bool(metadata.st_mode & 0o111)


def safe_environment() -> dict[str, str]:
    environment = {
        "GIT_ASKPASS": "/bin/false",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_SSH_COMMAND": "/bin/false",
        "GIT_TERMINAL_PROMPT": "0",
        "HOME": str(INTERVIEW_HOME),
        "LANG": "C.UTF-8",
        "LOGNAME": "coder",
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "SHELL": "/bin/bash",
        "SSH_ASKPASS": "/bin/false",
        "USER": "coder",
    }
    term = os.environ.get("TERM", "xterm-256color")
    if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9+._-]{0,63}", term):
        environment["TERM"] = term
    else:
        environment["TERM"] = "xterm-256color"
    return environment


def verify_repository(environment: dict[str, str]) -> None:
    git_directory = INTERVIEW_REPOSITORY / ".git"
    git_config = git_directory / "config"
    try:
        git_directory_metadata = git_directory.lstat()
        git_config_metadata = git_config.lstat()
    except OSError:
        fail("Expected interview repository is unavailable.")
    if not stat.S_ISDIR(git_directory_metadata.st_mode) or not stat.S_ISREG(
        git_config_metadata.st_mode
    ):
        fail("Expected interview repository is unavailable.")

    names = subprocess.run(
        [
            "/usr/bin/git",
            "config",
            "--file",
            str(git_config),
            "--no-includes",
            "--name-only",
            "--list",
        ],
        check=False,
        capture_output=True,
        env=environment,
        text=True,
        timeout=10,
    )
    if names.returncode != 0:
        fail("Expected interview repository Git configuration is unreadable.")
    if any(UNSAFE_GIT_CONFIG.search(name) for name in names.stdout.splitlines()):
        fail("Expected interview repository contains unsafe Git transport configuration.")

    origin = subprocess.run(
        [
            "/usr/bin/git",
            "config",
            "--file",
            str(git_config),
            "--no-includes",
            "--get",
            "remote.origin.url",
        ],
        check=False,
        capture_output=True,
        env=environment,
        text=True,
        timeout=10,
    )
    if origin.returncode != 0 or origin.stdout.strip() not in EXPECTED_ORIGINS:
        fail("Expected interview repository has the wrong origin.")

    remote_urls = subprocess.run(
        [
            "/usr/bin/git",
            "config",
            "--file",
            str(git_config),
            "--no-includes",
            "--get-regexp",
            r"^remote\..*\.(url|pushurl)$",
        ],
        check=False,
        capture_output=True,
        env=environment,
        text=True,
        timeout=10,
    )
    if remote_urls.returncode not in {0, 1}:
        fail("Expected interview repository Git configuration is unreadable.")
    for remote_line in remote_urls.stdout.splitlines():
        _name, separator, remote_url = remote_line.partition(" ")
        if not separator or remote_url.strip() not in EXPECTED_ORIGINS:
            fail("Expected interview repository contains an unsafe remote URL.")


def open_terminal() -> int:
    try:
        terminal = os.open("/dev/tty", os.O_RDWR)
    except OSError:
        fail("A controlling terminal is required for Interview Claude.")

    try:
        termios.tcgetattr(terminal)
    except OSError:
        os.close(terminal)
        fail("Unable to access the Interview Claude terminal.")
    return terminal


def close_terminal(terminal: int) -> None:
    os.close(terminal)


class EphemeralHandoffDecryptor:
    """Keep the handoff RSA private key only in a protected anonymous fd."""

    def __init__(self) -> None:
        if not hasattr(os, "memfd_create") or not regular_executable(Path("/usr/bin/openssl")):
            fail("The protected key-handoff cryptography is unavailable.")
        self.private_key_fd = os.memfd_create(
            "hive-interview-key-handoff",
            getattr(os, "MFD_CLOEXEC", 0x0001),
        )
        os.fchmod(self.private_key_fd, 0o600)
        generated = subprocess.run(
            [
                "/usr/bin/openssl",
                "genpkey",
                "-algorithm",
                "RSA",
                "-pkeyopt",
                "rsa_keygen_bits:3072",
            ],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=self.private_key_fd,
            stderr=subprocess.DEVNULL,
            timeout=30,
        )
        if generated.returncode != 0:
            self.close()
            fail("Unable to initialize protected key-handoff cryptography.")
        os.lseek(self.private_key_fd, 0, os.SEEK_SET)
        exported = subprocess.run(
            [
                "/usr/bin/openssl",
                "pkey",
                "-pubout",
                "-outform",
                "DER",
                "-in",
                f"/proc/self/fd/{self.private_key_fd}",
            ],
            check=False,
            capture_output=True,
            pass_fds=(self.private_key_fd,),
            timeout=10,
        )
        if exported.returncode != 0 or not exported.stdout:
            self.close()
            fail("Unable to initialize protected key-handoff cryptography.")
        self.public_key_b64 = base64.b64encode(exported.stdout).decode("ascii")
        self.decrypt_lock = threading.Lock()

    def decrypt(self, ciphertext: bytes) -> bytearray:
        if len(ciphertext) != KEY_HANDOFF_RSA_BYTES:
            raise ValueError("invalid encrypted key")
        with self.decrypt_lock:
            os.lseek(self.private_key_fd, 0, os.SEEK_SET)
            decrypted = subprocess.run(
                [
                    "/usr/bin/openssl",
                    "pkeyutl",
                    "-decrypt",
                    "-inkey",
                    f"/proc/self/fd/{self.private_key_fd}",
                    "-pkeyopt",
                    "rsa_padding_mode:oaep",
                    "-pkeyopt",
                    "rsa_oaep_md:sha256",
                    "-pkeyopt",
                    "rsa_mgf1_md:sha256",
                ],
                check=False,
                input=ciphertext,
                capture_output=True,
                pass_fds=(self.private_key_fd,),
                timeout=10,
            )
        key = bytearray(decrypted.stdout)
        if (
            decrypted.returncode != 0
            or not key
            or len(key) > MAX_HANDOFF_KEY_BYTES
            or any(character < 0x21 or character > 0x7E for character in key)
        ):
            wipe(key)
            raise ValueError("invalid encrypted key")
        return key

    def close(self) -> None:
        private_key_fd = getattr(self, "private_key_fd", -1)
        if private_key_fd < 0:
            return
        try:
            size = os.fstat(private_key_fd).st_size
            os.lseek(private_key_fd, 0, os.SEEK_SET)
            while size > 0:
                chunk_size = min(size, 64 * 1024)
                os.write(private_key_fd, b"\0" * chunk_size)
                size -= chunk_size
        except OSError:
            pass
        os.close(private_key_fd)
        self.private_key_fd = -1


class PendingLaunch:
    def __init__(self) -> None:
        self.event = threading.Event()
        self.key: bytearray | None = None
        self.error: bytes | None = None
        self.claimed = False
        self.active_slot = False


class LaunchCoordinator:
    def __init__(self) -> None:
        self.decryptor = EphemeralHandoffDecryptor()
        self.lock = threading.Lock()
        self.pending: dict[str, PendingLaunch] = {}
        self.pending_slots = threading.BoundedSemaphore(MAX_PENDING_LAUNCHES)
        self.active_session = threading.Lock()

    def register(self) -> tuple[str, PendingLaunch] | None:
        if not self.pending_slots.acquire(blocking=False):
            return None
        pending = PendingLaunch()
        with self.lock:
            while True:
                pairing_code = secrets.token_urlsafe(24)
                if pairing_code not in self.pending:
                    self.pending[pairing_code] = pending
                    return pairing_code, pending

    def deliver(self, pairing_code: str, ciphertext: bytes) -> tuple[int, str]:
        with self.lock:
            pending = self.pending.get(pairing_code)
            if pending is None or pending.claimed or pending.event.is_set():
                return 404, "Pairing code is unavailable. Start Interview Claude again."
            pending.claimed = True
        try:
            key = self.decryptor.decrypt(ciphertext)
        except (OSError, subprocess.SubprocessError, ValueError):
            with self.lock:
                if self.pending.get(pairing_code) is pending:
                    pending.claimed = False
            return 400, "The encrypted key was rejected."

        if not self.active_session.acquire(blocking=False):
            wipe(key)
            with self.lock:
                if self.pending.get(pairing_code) is pending:
                    pending.error = b"Another Interview Claude session is active."
                    pending.event.set()
            return 409, "Another Interview Claude session is active."

        with self.lock:
            if self.pending.get(pairing_code) is not pending or pending.event.is_set():
                self.active_session.release()
                wipe(key)
                return 404, "Pairing code is unavailable. Start Interview Claude again."
            pending.key = key
            pending.active_slot = True
            pending.event.set()
        return 200, "Key accepted. Return to the Interview Claude terminal."

    def wait(
        self,
        pairing_code: str,
        pending: PendingLaunch,
        connection: socket.socket,
    ) -> bytearray | None:
        deadline = time.monotonic() + KEY_HANDOFF_TIMEOUT_SECONDS
        delivered = False
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            if pending.event.wait(min(remaining, 0.1)):
                delivered = True
                break
            try:
                peer_data = connection.recv(1, socket.MSG_PEEK | socket.MSG_DONTWAIT)
            except BlockingIOError:
                continue
            if not peer_data:
                break
        self.cancel(pairing_code, pending)
        if not delivered:
            return None
        return pending.key

    def cancel(self, pairing_code: str, pending: PendingLaunch) -> None:
        with self.lock:
            if self.pending.get(pairing_code) is not pending:
                return
            del self.pending[pairing_code]
        self.pending_slots.release()

    def finish(self, pending: PendingLaunch) -> None:
        if pending.active_slot:
            pending.active_slot = False
            self.active_session.release()

    def close(self) -> None:
        self.decryptor.close()


class KeyHandoffServer(http.server.ThreadingHTTPServer):
    allow_reuse_address = False
    daemon_threads = True

    def __init__(self, coordinator: LaunchCoordinator) -> None:
        self.coordinator = coordinator
        super().__init__(("127.0.0.1", KEY_HANDOFF_PORT), KeyHandoffHandler)


class KeyHandoffHandler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.0"
    server_version = "HiveInterviewKeyHandoff"
    sys_version = ""

    def log_message(self, _format: str, *_arguments: object) -> None:
        return

    def send_payload(self, status: int, content_type: str, payload: bytes) -> None:
        self.send_response(status)
        self.send_header("Cache-Control", "no-store, max-age=0")
        self.send_header("Content-Security-Policy", "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'self'; form-action 'self'; frame-ancestors 'self'")
        self.send_header("Content-Type", content_type)
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def do_GET(self) -> None:
        path = urllib.parse.urlsplit(self.path).path
        if path == "/health":
            self.send_payload(200, "text/plain; charset=utf-8", b"ok\n")
            return
        if path != "/":
            self.send_payload(404, "text/plain; charset=utf-8", b"not found\n")
            return
        public_key = self.server.coordinator.decryptor.public_key_b64
        page = KEY_HANDOFF_PAGE.replace("__PUBLIC_KEY_B64__", public_key).encode("utf-8")
        self.send_payload(200, "text/html; charset=utf-8", page)

    def do_POST(self) -> None:
        if urllib.parse.urlsplit(self.path).path != "/handoff":
            self.send_payload(404, "application/json", b'{"message":"not found"}\n')
            return
        try:
            content_length = int(self.headers.get("Content-Length", ""))
        except ValueError:
            content_length = -1
        if content_length < 2 or content_length > 8 * 1024:
            self.send_payload(400, "application/json", b'{"message":"invalid request"}\n')
            return
        try:
            document = json.loads(self.rfile.read(content_length))
            pairing_code = document["pairing_code"]
            ciphertext = base64.b64decode(document["encrypted_key"], validate=True)
            if (
                not isinstance(pairing_code, str)
                or re.fullmatch(r"[A-Za-z0-9_-]{32}", pairing_code) is None
            ):
                raise ValueError("invalid pairing code")
        except (KeyError, TypeError, ValueError, json.JSONDecodeError):
            self.send_payload(400, "application/json", b'{"message":"invalid request"}\n')
            return
        status, message = self.server.coordinator.deliver(pairing_code, ciphertext)
        payload = json.dumps({"message": message}, separators=(",", ":")).encode("utf-8") + b"\n"
        self.send_payload(status, "application/json", payload)


KEY_HANDOFF_PAGE = """<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Interview Claude Key</title><style>
body{font:16px system-ui,sans-serif;max-width:42rem;margin:4rem auto;padding:0 1rem;color:#172033;background:#f7f9fc}
main{background:white;border:1px solid #d8dfeb;border-radius:12px;padding:1.5rem}label{display:block;font-weight:650;margin-top:1rem}
input,button{box-sizing:border-box;width:100%;font:inherit;padding:.75rem;margin-top:.4rem}button{cursor:pointer;font-weight:650}
#result{min-height:1.5rem;margin-top:1rem}.error{color:#a31515}.ok{color:#126b32}
</style></head><body><main><h1>Interview Claude Key</h1>
<p>Start <code>interview-claude</code>, then paste its one-time pairing code and the interviewer-provided temporary key here. The browser encrypts the key before it enters the workspace network.</p>
<form id="handoff" autocomplete="off"><label for="pairing">Pairing code</label><input id="pairing" required autocapitalize="off" spellcheck="false">
<label for="key">Temporary Anthropic API key</label><input id="key" type="password" required autocomplete="off" autocapitalize="off" spellcheck="false">
<button type="submit">Launch Interview Claude</button></form><p id="result" role="status"></p></main><script>
const publicKeyB64="__PUBLIC_KEY_B64__";
const bytesFromB64=(value)=>Uint8Array.from(atob(value),(character)=>character.charCodeAt(0));
const b64FromBytes=(value)=>{let result="";for(const byte of new Uint8Array(value))result+=String.fromCharCode(byte);return btoa(result)};
document.getElementById("handoff").addEventListener("submit",async(event)=>{event.preventDefault();const button=event.target.querySelector("button");const result=document.getElementById("result");const keyInput=document.getElementById("key");button.disabled=true;result.className="";result.textContent="Encrypting and handing off…";try{const encoded=new TextEncoder().encode(keyInput.value);if(!encoded.length||encoded.length>256)throw new Error("The temporary key length is invalid.");const publicKey=await crypto.subtle.importKey("spki",bytesFromB64(publicKeyB64),{name:"RSA-OAEP",hash:"SHA-256"},false,["encrypt"]);const encrypted=await crypto.subtle.encrypt({name:"RSA-OAEP"},publicKey,encoded);keyInput.value="";const response=await fetch("handoff",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({pairing_code:document.getElementById("pairing").value.trim(),encrypted_key:b64FromBytes(encrypted)})});const body=await response.json();result.textContent=body.message||"Key handoff failed.";result.className=response.ok?"ok":"error"}catch(error){keyInput.value="";result.textContent=error instanceof Error?error.message:"Key handoff failed.";result.className="error"}finally{button.disabled=false}});
</script></body></html>"""


class AnthropicBroker(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    allow_reuse_address = False
    daemon_threads = True

    def __init__(self, api_key: bytearray, socket_path: Path) -> None:
        super().__init__(str(socket_path), AnthropicBrokerHandler)
        self.api_key = api_key
        self.claude_pid: int | None = None


class AnthropicBrokerHandler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.0"
    server_version = "HiveInterviewBroker"
    sys_version = ""

    def log_message(self, _format: str, *_arguments: object) -> None:
        return

    def do_GET(self) -> None:
        self.forward_request()

    def do_POST(self) -> None:
        self.forward_request()

    def do_CONNECT(self) -> None:
        self.send_error(405, "CONNECT is not permitted")

    def forward_request(self) -> None:
        peer_credentials = self.connection.getsockopt(
            socket.SOL_SOCKET,
            socket.SO_PEERCRED,
            struct.calcsize("3i"),
        )
        peer_pid, _peer_uid, _peer_gid = struct.unpack("3i", peer_credentials)
        if self.server.claude_pid is None or peer_pid != self.server.claude_pid:
            self.send_error(403, "Only the protected Claude process may use this broker")
            return

        parsed = urllib.parse.urlsplit(self.path)
        if (
            parsed.scheme
            or parsed.netloc
            or (self.command, parsed.path) not in ALLOWED_ANTHROPIC_REQUESTS
        ):
            self.send_error(403, "Only required Anthropic API requests are permitted")
            return
        if self.headers.get("Transfer-Encoding") is not None:
            self.send_error(400, "Transfer-Encoding is not supported")
            return
        content_lengths = self.headers.get_all("Content-Length", failobj=[])
        if len(content_lengths) > 1:
            self.send_error(400, "Ambiguous Content-Length")
            return
        try:
            content_length = int(content_lengths[0]) if content_lengths else 0
        except ValueError:
            self.send_error(400, "Invalid Content-Length")
            return
        if content_length < 0 or content_length > MAX_REQUEST_BYTES:
            self.send_error(413, "Request body is too large")
            return
        request_body = self.rfile.read(content_length)
        if len(request_body) != content_length:
            self.send_error(400, "Incomplete request body")
            return

        forwarded_headers: dict[str, str] = {}
        for name, value in self.headers.items():
            lowered = name.lower()
            if (
                lowered in HOP_BY_HOP_HEADERS
                or lowered in {"authorization", "content-length", "host", "x-api-key"}
                or lowered.startswith("x-forwarded-")
            ):
                continue
            forwarded_headers[name] = value
        forwarded_headers["Host"] = ANTHROPIC_UPSTREAM_HOST
        forwarded_headers["X-Api-Key"] = bytes(self.server.api_key).decode("ascii")
        forwarded_headers["Content-Length"] = str(content_length)

        if ANTHROPIC_UPSTREAM_TLS:
            connection = http.client.HTTPSConnection(
                ANTHROPIC_UPSTREAM_HOST,
                ANTHROPIC_UPSTREAM_PORT,
                timeout=660,
                context=ssl.create_default_context(),
            )
        else:
            connection = http.client.HTTPConnection(
                ANTHROPIC_UPSTREAM_HOST,
                ANTHROPIC_UPSTREAM_PORT,
                timeout=660,
            )
        response_started = False
        try:
            target = urllib.parse.urlunsplit(("", "", parsed.path, parsed.query, ""))
            connection.request(
                self.command,
                target,
                body=request_body,
                headers=forwarded_headers,
            )
            response = connection.getresponse()
            self.send_response_only(response.status, response.reason)
            for name, value in response.getheaders():
                if name.lower() not in HOP_BY_HOP_HEADERS:
                    self.send_header(name, value)
            self.send_header("Connection", "close")
            self.end_headers()
            response_started = True
            while True:
                chunk = response.read(64 * 1024)
                if not chunk:
                    break
                self.wfile.write(chunk)
                self.wfile.flush()
        except (OSError, http.client.HTTPException, ssl.SSLError):
            if not response_started and not self.wfile.closed:
                self.send_error(502, "Anthropic API request failed")
        finally:
            connection.close()
            self.close_connection = True


def private_broker_socket() -> tuple[Path, Path]:
    configuration_directory = INTERVIEW_HOME / ".claude"
    try:
        metadata = configuration_directory.lstat()
    except OSError:
        fail("The isolated Claude configuration directory is unavailable.")
    if not stat.S_ISDIR(metadata.st_mode):
        fail("The isolated Claude configuration directory is unsafe.")
    try:
        broker_directory = Path(
            tempfile.mkdtemp(prefix=".hive-interview-broker.", dir=configuration_directory)
        )
    except OSError:
        fail("Unable to create the private Anthropic broker socket directory.")
    return broker_directory, broker_directory / "anthropic.sock"


def wipe(secret: bytearray) -> None:
    for index in range(len(secret)):
        secret[index] = 0


def receive_exact(connection: socket.socket, size: int) -> bytes:
    payload = bytearray(size)
    view = memoryview(payload)
    received = 0
    while received < size:
        count = connection.recv_into(view[received:])
        if count == 0:
            raise EOFError("launch connection closed")
        received += count
    return bytes(payload)


def send_frame(connection: socket.socket, frame_type: int, payload: bytes = b"") -> None:
    if len(payload) > MAX_FRAME_BYTES:
        raise ValueError("launch frame is too large")
    connection.sendall(FRAME_HEADER.pack(frame_type, len(payload)))
    if payload:
        connection.sendall(payload)


def receive_frame(connection: socket.socket) -> tuple[int, bytes]:
    frame_type, length = FRAME_HEADER.unpack(receive_exact(connection, FRAME_HEADER.size))
    if length > MAX_FRAME_BYTES:
        raise ValueError("launch frame is too large")
    return frame_type, receive_exact(connection, length)


def terminal_size(terminal: int) -> tuple[int, int]:
    try:
        rows, columns, _x_pixels, _y_pixels = struct.unpack(
            "HHHH",
            fcntl.ioctl(terminal, termios.TIOCGWINSZ, b"\0" * 8),
        )
    except OSError:
        return 24, 80
    return max(rows, 1), max(columns, 1)


def apply_terminal_size(terminal: int, rows: int, columns: int) -> None:
    fcntl.ioctl(
        terminal,
        termios.TIOCSWINSZ,
        struct.pack("HHHH", max(rows, 1), max(columns, 1), 0, 0),
    )


def parse_launch_request(
    connection: socket.socket,
) -> tuple[list[str], int, int]:
    header = receive_exact(connection, LAUNCH_REQUEST_HEADER.size)
    magic, argument_count, argument_bytes, rows, columns = LAUNCH_REQUEST_HEADER.unpack(header)
    if magic != LAUNCH_PROTOCOL_MAGIC:
        raise ValueError("invalid launch protocol")
    if argument_count > MAX_LAUNCH_ARGUMENTS or argument_bytes > MAX_LAUNCH_ARGUMENT_BYTES:
        raise ValueError("invalid launch arguments")

    try:
        arguments: list[str] = []
        consumed = 0
        for _index in range(argument_count):
            encoded_length = struct.unpack("!I", receive_exact(connection, 4))[0]
            consumed += 4 + encoded_length
            if encoded_length > MAX_LAUNCH_ARGUMENT_BYTES or consumed > argument_bytes:
                raise ValueError("invalid launch arguments")
            encoded = receive_exact(connection, encoded_length)
            if b"\0" in encoded:
                raise ValueError("invalid launch arguments")
            arguments.append(encoded.decode("utf-8"))
        if consumed != argument_bytes:
            raise ValueError("invalid launch arguments")
        return arguments, max(rows, 1), max(columns, 1)
    except (UnicodeDecodeError, ValueError):
        raise


def terminate_process_group(process: subprocess.Popen[bytes]) -> None:
    if process.poll() is not None:
        return
    try:
        os.killpg(process.pid, signal.SIGTERM)
        process.wait(timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except OSError:
            pass
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            pass


def protected_claude_session(
    connection: socket.socket,
    arguments: list[str],
    key: bytearray,
    rows: int,
    columns: int,
) -> int:
    environment = safe_environment()
    verify_repository(environment)
    if not regular_executable(TRUSTED_CLAUDE) or not regular_executable(TRUSTED_GUARD):
        fail("The read-only image-baked Claude Code executable is unavailable.")

    broker_directory, broker_socket = private_broker_socket()
    try:
        broker = AnthropicBroker(key, broker_socket)
        os.chmod(broker_socket, 0o600)
    except OSError:
        shutil.rmtree(broker_directory, ignore_errors=True)
        fail("Unable to establish the protected Anthropic credential broker.")

    environment["ANTHROPIC_API_KEY"] = BROKER_PLACEHOLDER_KEY
    environment["ANTHROPIC_BASE_URL"] = f"http://127.0.0.1:{BROKER_REDIRECT_PORT}"
    # The trusted whitelist already excludes every credential, and the preload
    # guard removes the broker route before Claude can exec a child. Forcing
    # Claude's optional bwrap-based scrub would make the pinned rollout image
    # refuse to start because that image intentionally has no bubblewrap.
    environment["CLAUDE_CODE_SUBPROCESS_ENV_SCRUB"] = "0"
    environment["HIVE_INTERVIEW_BROKER_PORT"] = str(BROKER_REDIRECT_PORT)
    environment["HIVE_INTERVIEW_BROKER_SOCKET"] = str(broker_socket)
    environment["LD_PRELOAD"] = str(TRUSTED_GUARD)
    broker_thread: threading.Thread | None = None
    process: subprocess.Popen[bytes] | None = None
    master_terminal = -1
    slave_terminal = -1
    client_connected = True
    terminal_open = True
    try:
        master_terminal, slave_terminal = pty.openpty()
        apply_terminal_size(slave_terminal, rows, columns)

        def establish_controlling_terminal() -> None:
            os.setsid()
            fcntl.ioctl(slave_terminal, TIOCSCTTY, 0)

        try:
            process = subprocess.Popen(
                [str(TRUSTED_CLAUDE), *arguments],
                cwd=INTERVIEW_REPOSITORY,
                env=environment,
                stdin=slave_terminal,
                stdout=slave_terminal,
                stderr=slave_terminal,
                close_fds=True,
                preexec_fn=establish_controlling_terminal,
            )
        except OSError:
            fail("Unable to execute the read-only Claude Code binary.")
        os.close(slave_terminal)
        slave_terminal = -1

        broker.claude_pid = process.pid
        broker_thread = threading.Thread(target=broker.serve_forever, daemon=True)
        broker_thread.start()

        while True:
            try:
                monitored = [connection]
                if terminal_open:
                    monitored.append(master_terminal)
                readable, _writable, _exceptional = select.select(monitored, [], [], 0.1)
            except InterruptedError:
                continue

            if master_terminal in readable:
                try:
                    output = os.read(master_terminal, 64 * 1024)
                except OSError as error:
                    if error.errno != errno.EIO:
                        raise
                    output = b""
                if output:
                    try:
                        send_frame(connection, FRAME_OUTPUT, output)
                    except (BrokenPipeError, ConnectionError, EOFError):
                        client_connected = False
                        break
                else:
                    terminal_open = False

            if connection in readable:
                try:
                    frame_type, payload = receive_frame(connection)
                except (BrokenPipeError, ConnectionError, EOFError):
                    client_connected = False
                    break
                if frame_type == FRAME_INPUT:
                    os.write(master_terminal, payload)
                elif frame_type == FRAME_RESIZE and len(payload) == 4:
                    next_rows, next_columns = struct.unpack("!HH", payload)
                    apply_terminal_size(master_terminal, next_rows, next_columns)
                else:
                    raise ValueError("invalid client launch frame")

            if process.poll() is not None and (
                not terminal_open or master_terminal not in readable
            ):
                break

        if not client_connected:
            terminate_process_group(process)
        return_code = process.wait()
        return return_code if return_code >= 0 else 128 - return_code
    finally:
        if process is not None:
            terminate_process_group(process)
        if slave_terminal >= 0:
            os.close(slave_terminal)
        if master_terminal >= 0:
            os.close(master_terminal)
        if broker_thread is not None:
            broker.shutdown()
        broker.server_close()
        if broker_thread is not None:
            broker_thread.join(timeout=5)
        shutil.rmtree(broker_directory, ignore_errors=True)
        wipe(key)


def handle_launch_connection(
    connection: socket.socket,
    coordinator: LaunchCoordinator,
) -> None:
    peer_credentials = connection.getsockopt(
        socket.SOL_SOCKET,
        socket.SO_PEERCRED,
        struct.calcsize("3i"),
    )
    _peer_pid, peer_uid, peer_gid = struct.unpack("3i", peer_credentials)
    if peer_uid != CLIENT_UID or peer_gid != CLIENT_GID:
        send_frame(connection, FRAME_ERROR, b"Unauthorized Claude launch client.")
        return

    pending: PendingLaunch | None = None
    pairing_code: str | None = None
    key: bytearray | None = None
    try:
        connection.settimeout(LAUNCH_HANDSHAKE_TIMEOUT_SECONDS)
        arguments, rows, columns = parse_launch_request(connection)
        connection.settimeout(None)
        registered = coordinator.register()
        if registered is None:
            send_frame(connection, FRAME_ERROR, b"Too many Interview Claude launches are pending.")
            return
        pairing_code, pending = registered
        send_frame(connection, FRAME_PAIRING, pairing_code.encode("ascii"))
        key = coordinator.wait(pairing_code, pending, connection)
        if key is None:
            send_frame(
                connection,
                FRAME_ERROR,
                pending.error or b"Key handoff timed out. Start Interview Claude again.",
            )
            return
        return_code = protected_claude_session(connection, arguments, key, rows, columns)
        key = None
        send_frame(connection, FRAME_EXIT, struct.pack("!i", return_code))
    except (EOFError, OSError, ValueError):
        try:
            send_frame(connection, FRAME_ERROR, b"Protected Claude launch failed.")
        except (BrokenPipeError, ConnectionError, OSError):
            pass
    finally:
        if key is not None:
            wipe(key)
        if pending is not None:
            coordinator.finish(pending)
            if pairing_code is not None:
                coordinator.cancel(pairing_code, pending)


def serve_launch_socket(socket_path: Path) -> NoReturn:
    try:
        parent_metadata = socket_path.parent.lstat()
    except OSError:
        fail("The protected Claude launch volume is unavailable.")
    if not stat.S_ISDIR(parent_metadata.st_mode) or socket_path.parent.is_symlink():
        fail("The protected Claude launch volume is unsafe.")

    try:
        existing = socket_path.lstat()
    except FileNotFoundError:
        existing = None
    except OSError:
        fail("The protected Claude launch socket is unsafe.")
    if existing is not None:
        if not stat.S_ISSOCK(existing.st_mode) or existing.st_uid != os.getuid():
            fail("The protected Claude launch socket is unsafe.")
        socket_path.unlink()

    coordinator = LaunchCoordinator()
    try:
        handoff_server = KeyHandoffServer(coordinator)
    except OSError:
        coordinator.close()
        fail("Unable to bind the protected key-handoff application.")
    handoff_thread = threading.Thread(target=handoff_server.serve_forever, daemon=True)
    handoff_thread.start()
    listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    connection_slots = threading.BoundedSemaphore(MAX_LAUNCH_CONNECTIONS)

    def serve_connection(connection: socket.socket) -> None:
        try:
            with connection:
                handle_launch_connection(connection, coordinator)
        finally:
            connection_slots.release()

    try:
        listener.bind(str(socket_path))
        os.chmod(socket_path, 0o660)
        listener.listen(MAX_LAUNCH_CONNECTIONS)
        while True:
            connection, _address = listener.accept()
            if not connection_slots.acquire(blocking=False):
                with connection:
                    try:
                        send_frame(connection, FRAME_ERROR, b"Interview Claude is busy. Retry shortly.")
                    except OSError:
                        pass
                continue
            threading.Thread(
                target=serve_connection,
                args=(connection,),
                daemon=True,
            ).start()
    finally:
        listener.close()
        handoff_server.shutdown()
        handoff_server.server_close()
        handoff_thread.join(timeout=5)
        coordinator.close()
        try:
            metadata = socket_path.lstat()
            if stat.S_ISSOCK(metadata.st_mode) and metadata.st_uid == os.getuid():
                socket_path.unlink()
        except OSError:
            pass
    raise SystemExit(1)


def send_launch_request(
    connection: socket.socket,
    arguments: list[str],
    rows: int,
    columns: int,
) -> None:
    if len(arguments) > MAX_LAUNCH_ARGUMENTS:
        fail("Too many Claude arguments were provided.")
    encoded_arguments = []
    argument_bytes = 0
    for argument in arguments:
        try:
            encoded = argument.encode("utf-8")
        except UnicodeEncodeError:
            fail("Claude arguments must be valid UTF-8.")
        if b"\0" in encoded:
            fail("Claude arguments may not contain null bytes.")
        argument_bytes += 4 + len(encoded)
        if argument_bytes > MAX_LAUNCH_ARGUMENT_BYTES:
            fail("Claude arguments are unexpectedly large.")
        encoded_arguments.append(encoded)

    connection.sendall(
        LAUNCH_REQUEST_HEADER.pack(
            LAUNCH_PROTOCOL_MAGIC,
            len(encoded_arguments),
            argument_bytes,
            rows,
            columns,
        )
    )
    for encoded in encoded_arguments:
        connection.sendall(struct.pack("!I", len(encoded)))
        connection.sendall(encoded)


def run_launch_client(socket_path: Path, arguments: list[str]) -> int:
    try:
        socket_metadata = socket_path.lstat()
    except OSError:
        fail("The protected Claude runtime is not ready. Retry in a few seconds.")
    if not stat.S_ISSOCK(socket_metadata.st_mode) or socket_metadata.st_uid != PROTECTED_RUNTIME_UID:
        fail("The protected Claude launch socket is unsafe.")

    connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    terminal = -1
    original_terminal = None
    original_winch_handler = None
    try:
        terminal = open_terminal()
        rows, columns = terminal_size(terminal)

        connection.settimeout(10)
        connection.connect(str(socket_path))
        peer_credentials = connection.getsockopt(
            socket.SOL_SOCKET,
            socket.SO_PEERCRED,
            struct.calcsize("3i"),
        )
        _peer_pid, peer_uid, _peer_gid = struct.unpack("3i", peer_credentials)
        if peer_uid != PROTECTED_RUNTIME_UID:
            fail("The protected Claude runtime identity is invalid.")
        connection.settimeout(None)

        send_launch_request(connection, arguments, rows, columns)
        frame_type, payload = receive_frame(connection)
        if frame_type == FRAME_ERROR:
            os.write(terminal, b"\r\n[error] " + payload + b"\r\n")
            return 1
        if frame_type != FRAME_PAIRING:
            fail("The protected Claude runtime returned an invalid response.")
        try:
            pairing_code = payload.decode("ascii")
        except UnicodeDecodeError:
            fail("The protected Claude runtime returned an invalid pairing code.")
        if re.fullmatch(r"[A-Za-z0-9_-]{32}", pairing_code) is None:
            fail("The protected Claude runtime returned an invalid pairing code.")
        os.write(
            terminal,
            (
                "\r\nOpen the owner-only Interview Claude Key app.\r\n"
                f"Pairing code: {pairing_code}\r\n"
                "Waiting for encrypted key handoff...\r\n\r\n"
            ).encode("ascii"),
        )

        original_terminal = termios.tcgetattr(terminal)
        tty.setraw(terminal, termios.TCSADRAIN)
        resize_pending = [False]

        def request_resize(_signum: int, _frame: object) -> None:
            resize_pending[0] = True

        original_winch_handler = signal.signal(signal.SIGWINCH, request_resize)
        while True:
            if resize_pending[0]:
                resize_pending[0] = False
                next_rows, next_columns = terminal_size(terminal)
                send_frame(connection, FRAME_RESIZE, struct.pack("!HH", next_rows, next_columns))

            try:
                readable, _writable, _exceptional = select.select(
                    [terminal, connection], [], [], 0.25
                )
            except InterruptedError:
                continue
            if terminal in readable:
                terminal_input = os.read(terminal, 64 * 1024)
                if not terminal_input:
                    return 1
                send_frame(connection, FRAME_INPUT, terminal_input)
            if connection in readable:
                frame_type, payload = receive_frame(connection)
                if frame_type == FRAME_OUTPUT:
                    os.write(terminal, payload)
                elif frame_type == FRAME_EXIT and len(payload) == 4:
                    return_code = struct.unpack("!i", payload)[0]
                    return return_code if return_code >= 0 else 128 - return_code
                elif frame_type == FRAME_ERROR:
                    os.write(terminal, b"\r\n[error] " + payload + b"\r\n")
                    return 1
                else:
                    fail("The protected Claude runtime returned an invalid response.")
    except (BrokenPipeError, ConnectionError, EOFError, OSError):
        fail("The protected Claude runtime connection was interrupted.")
    finally:
        if original_winch_handler is not None:
            signal.signal(signal.SIGWINCH, original_winch_handler)
        if original_terminal is not None and terminal >= 0:
            try:
                termios.tcsetattr(terminal, termios.TCSADRAIN, original_terminal)
            except OSError:
                pass
        if terminal >= 0:
            close_terminal(terminal)
        connection.close()
    return 1


def main() -> None:
    make_process_nondumpable()
    if len(sys.argv) < 3 or sys.argv[1] not in {"--client", "--serve"}:
        fail("This launcher may only run as the managed Claude client or runtime service.")

    socket_path = Path(sys.argv[2])
    if not socket_path.is_absolute():
        fail("The protected Claude launch socket path must be absolute.")
    if sys.argv[1] == "--serve":
        if len(sys.argv) != 3:
            fail("The protected Claude runtime service does not accept arguments.")
        serve_launch_socket(socket_path)

    arguments = sys.argv[3:]
    if arguments[:1] == ["--"]:
        arguments = arguments[1:]
    raise SystemExit(run_launch_client(socket_path, arguments))


if __name__ == "__main__":
    main()
