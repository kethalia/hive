#!/bin/sh
set -eu
unset GH_TOKEN GITHUB_TOKEN CODER_SESSION_TOKEN
export GIT_ASKPASS=/bin/false
export GIT_TERMINAL_PROMPT=0
python3 - <<'HIVE_GITHUB_PREFLIGHT'
import os
from pathlib import Path
import sys
import urllib.error
import urllib.request

home = Path.home()
if any(path.exists() for path in [
    home / ".config/gh/hosts.yml", home / ".config/coderv2/session", home / ".git-credentials",
    home / ".config/git/credentials",
]):
    sys.exit("Scoped GitHub access requires a fresh workspace home.")
origin = "${coder_origin}"
if not origin.startswith("https://"):
    sys.exit("Scoped workspace requires an HTTPS Coder deployment.")

class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args):
        return None

# Coder's explicit provider-ID path can issue a personal token even when the
# template declares no external-auth provider. Require that route and the Git
# hostname fallback to be denied before exposing the workspace terminal.
for route in ("external-auth?id=github", "external-auth?match=https%3A%2F%2Fgithub.com", "gitsshkey"):
    req = urllib.request.Request(origin + "/api/v2/workspaceagents/me/" + route,
                                 headers={"Coder-Session-Token": os.environ["CODER_AGENT_TOKEN"]})
    try:
        with urllib.request.build_opener(NoRedirect).open(req, timeout=10):
            sys.exit("Scoped GitHub access requires Coder to deny personal Git credentials for this agent.")
    except urllib.error.HTTPError as exc:
        if exc.code not in (403, 404):
            sys.exit("Could not verify the Coder GitHub credential boundary.")
HIVE_GITHUB_PREFLIGHT
${agent_init_script}
