DATABASE_URL=postgresql://hive:hive@localhost:5432/hive
REDIS_URL=redis://localhost:6379
# Set only for static/visual test servers that must not connect to queues.
HIVE_DISABLE_BACKGROUND_WORKERS=false
# 32-byte hex key for encrypting/decrypting per-user Coder API tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Shared absolute POSIX workspace home root used by Git clone discovery and clone terminal cwd setup.
# The web app scans this path inside the user's Coder workspace via coder ssh;
# the terminal proxy uses the same absolute root string for tmux cwd semantics.
HIVE_PROJECTS_ROOT=/home/coder

# Terminal proxy WebSocket URL (required for terminal sessions)
NEXT_PUBLIC_TERMINAL_WS_URL=ws://localhost:3001

# Comma-separated list of allowed origins for WebSocket connections (CSRF protection)
# Supports wildcards for ports (e.g. http://localhost:*)
# Defaults to http://localhost:* and https://localhost:* if not set
ALLOWED_ORIGINS=

# Auth service URL for session management and login delegation
AUTH_SERVICE_URL=http://localhost:4400

# Required internal service credential, shared by web, auth, and terminal proxy.
# Separate from COOKIE_SECRET and ENCRYPTION_KEY; never expose it to the browser or workspaces.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SERVICE_SECRET=

# HMAC-SHA256 secret for signing/verifying session cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# Legacy cookie Domain, used only to expire pre-migration cookies on login/logout.
# Live session cookies are always host-only; production uses __Host-hive-session.
# Keep the previous value during migration, then remove it after legacy cookies expire.
COOKIE_DOMAIN=

# Optional exact public terminal origin if its reverse proxy rewrites Host.
# Ticket audiences otherwise use the incoming Host. Example: https://terminal.example.com
TERMINAL_PUBLIC_ORIGIN=

# Server-owned Coder origin. Set the same value for web, auth, and terminal services.
# Login accepts only email/password; existing sessions for other origins are rejected.
# HTTPS is required in production. Use http://localhost:7080 only for local Coder development.
CODER_URL=https://coder.kethalia.com
# Optional PEM-encoded CA certificate for a Coder deployment using a private CA.
CODER_CA_CERT=

# Log level: trace | debug | info | warn | error (default: info)
LOG_LEVEL=info

# Auth service bind port (default: 4400)
AUTH_SERVICE_PORT=4400

# Terminal proxy bind host (default: 0.0.0.0)
BIND_HOST=0.0.0.0
# Experimental Codex browser voice controls (requires Codex 0.161.0+ in the workspace).
HIVE_CODEX_VOICE_ENABLED=false
# Exact public web origin when a reverse proxy uses a different origin hostname.
# Example: https://hive.example.com (no path). Forwarded headers alone are not trusted.
# Also used as the VAPID identity for push delivery, including iOS.
HIVE_PUBLIC_ORIGIN=
# Optional VAPID contact override: a public HTTPS URL or mailto address.
# Set this or HIVE_PUBLIC_ORIGIN to enable push delivery; avoid local-only domains.
VAPID_SUBJECT=
# Comma-separated additional web origins allowed for voice behind a reverse proxy.
HIVE_VOICE_ALLOWED_ORIGINS=

# Epic project discovery preview; requires an owner-authorized running software workspace.
HIVE_PROJECT_DISCOVERY_ENABLED=false
